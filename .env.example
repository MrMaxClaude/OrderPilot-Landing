# PostHog Configuration - Copy this to .env and fill in your actual values
# Project API key from PostHog (Settings → Project API key) — never commit real keys
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Set to false in production for better performance
VITE_PUBLIC_POSTHOG_DEBUG=true

# Backend API URL (DemoForm; calculator uses same-origin /api on Vercel)
VITE_API_URL=http://localhost:3001

# Resend — required for PDF email + contact form (Vercel + local server.js)
RESEND_API_KEY=your_resend_api_key_here
# Where contact-form leads are sent (default: info@order-pilot.ai)
# CONTACT_NOTIFY_TO=info@order-pilot.ai
# Verified sender in Resend (defaults to hello@orderpilot.com in API if unset)
# RESEND_FROM=OrderPilot <marketing@orderpilot.com>

# Production site URL for links inside transactional emails (Vercel: set to https://orderpilot.com)
# SITE_URL=https://orderpilot.com

PORT=3001