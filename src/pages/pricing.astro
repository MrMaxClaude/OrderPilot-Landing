---
import { getCollection, getEntry } from 'astro:content';
import { getMarkdownProcessor } from '../lib/markdown';
import PageLayout from '../layouts/PageLayout.astro';
import PricingPage from '../components/astro/PricingPage.astro';
import { buildFaqPageSchema, stripHtmlToPlainText } from '../lib/geoFaqSchema';

const pageMeta = await getEntry('pages', 'pricing');

const planEntries = await getCollection('plans');
const plans = planEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => p.data);

const mdProcessor = await getMarkdownProcessor();
const faqEntries = await getCollection('pricingFaqs');
const faqs = await Promise.all(
  faqEntries
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => {
      const { code } = await mdProcessor.render(entry.body);
      return { question: entry.data.question, answerHtml: code };
    }),
);

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://order-pilot.ai';

const pricingFaqSchema = buildFaqPageSchema({
  mainEntity: faqs.map((f) => ({
    name: f.question,
    text: stripHtmlToPlainText(f.answerHtml),
  })),
});

// Per-plan Product schema with Offer pricing. Plans with custom pricing
// (Enterprise) expose an Offer without a price and with availability Contact-sales.
const planProductSchemas = plans.map((plan) => {
  const hasPrice = plan.monthlyPrice != null;
  const offer: Record<string, unknown> = {
    '@type': 'Offer',
    availability: hasPrice
      ? 'https://schema.org/InStock'
      : 'https://schema.org/PreOrder',
    url: `${siteOrigin}/pricing/`,
  };
  if (hasPrice) {
    offer.price = String(plan.monthlyPrice);
    offer.priceCurrency = 'EUR';
    offer.priceSpecification = {
      '@type': 'UnitPriceSpecification',
      price: plan.monthlyPrice,
      priceCurrency: 'EUR',
      referenceQuantity: {
        '@type': 'QuantitativeValue',
        value: 1,
        unitCode: 'MON',
      },
    };
  }
  return {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `OrderPilot ${plan.name}`,
    description: plan.description,
    brand: { '@type': 'Brand', name: 'OrderPilot' },
    category: 'Purchase Order Automation Software',
    offers: offer,
  };
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: `${siteOrigin}/pricing/` },
  ],
};

const extraSchemas: Record<string, unknown>[] = [
  pricingFaqSchema,
  breadcrumbSchema,
  ...planProductSchemas,
];
---

<PageLayout
  title={pageMeta.data.title}
  description={pageMeta.data.description}
  ogImage={pageMeta.data.ogImage}
  noindex={pageMeta.data.noindex}
  extraJsonLd={extraSchemas}
>
  <PricingPage plans={plans} faqs={faqs} />
</PageLayout>
