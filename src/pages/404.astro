---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page not found (404) | OrderPilot"
  description="This OrderPilot page does not exist or has moved. Jump back to the homepage, explore the product, or ping us if you reached this via a saved link."
  noindex={true}
  showCalculatorCTA={false}
>
  <section class="min-h-[calc(100vh-6rem)] flex items-center justify-center px-4 sm:px-6 lg:px-8 bg-warm-bg">
    <div class="max-w-2xl w-full text-center pt-24 pb-20">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-text-muted mb-6">
        404 — not found
      </p>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-[800] tracking-tight text-text-primary leading-[1.05] mb-8 whitespace-nowrap sm:whitespace-normal">
        This page slipped the queue.{' '}
        <span class="font-serif italic text-rb2-orange whitespace-nowrap">Let's find it.</span>
      </h1>

      <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-xl mx-auto mb-10">
        The URL you followed doesn't match any OrderPilot page. The link may be out of date, mistyped, or the page may have moved.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <a
          href="/"
          class="w-full sm:w-auto bg-rb2-orange text-white rounded-2xl font-semibold px-8 py-4 hover:bg-rb2-orange-hover hover:shadow-lg transition-all duration-200 inline-flex items-center justify-center gap-2"
        >
          Back to homepage
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="/knowledge-base/"
          class="w-full sm:w-auto bg-card-white text-text-primary border border-gray-200 rounded-2xl font-semibold px-8 py-4 shadow-sm hover:bg-warm-bg-alt hover:shadow-md transition-all duration-200 inline-flex items-center justify-center gap-2"
        >
          Browse the knowledge base
        </a>
      </div>

      <p class="text-xs text-text-muted">
        <span class="whitespace-nowrap">Think this page should exist?</span>{' '}
        <a href="/#contact" class="text-rb2-orange font-semibold hover:underline whitespace-nowrap">Let us know</a>.
      </p>
    </div>
  </section>
</PageLayout>

<script>
  import posthog from 'posthog-js';
  // Fire once when a visitor lands on 404 so we can see broken links in analytics
  try {
    posthog.capture('page_not_found', {
      path: window.location.pathname,
      referrer: document.referrer || '(direct)',
    });
  } catch {
    // analytics not initialised yet — ignore; next request will pick it up
  }
</script>
