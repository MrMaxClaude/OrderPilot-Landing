---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** When true, adds <meta name="robots" content="noindex,nofollow">. Used for drafts, admin, thank-you pages. */
  noindex?: boolean;
  /** Extra JSON-LD objects (e.g. FAQPage) rendered as separate script tags */
  extraJsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'The world\'s most accurate purchase order processing platform. Built for procurement teams that demand 100% accuracy.',
  ogImage = '/orderpilot-logo.png',
  noindex = false,
  extraJsonLd = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://order-pilot.ai';
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OrderPilot',
  url: siteOrigin,
  email: 'info@order-pilot.ai',
  logo: new URL('/orderpilot-logo.png', siteOrigin).toString(),
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'info@order-pilot.ai',
      availableLanguage: ['English', 'Dutch'],
    },
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'OrderPilot',
  url: siteOrigin,
  inLanguage: 'en',
};
const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OrderPilot',
  description: 'AI-powered purchase order processing platform built for procurement teams that demand 100% accuracy.',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Purchase Order Automation',
  operatingSystem: 'Web',
  url: siteOrigin,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: '279',
    highPrice: '899',
    offerCount: '3',
    url: new URL('/pricing/', siteOrigin).toString(),
  },
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FF6321" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="OrderPilot" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareApplicationSchema)} />
    {extraJsonLd.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <Analytics />

    <!-- Google Analytics 4 - Consent Mode v2 (denied by default, granted on user accept).
         dataLayer + gtag shim are defined synchronously so any code that fires events
         pre-hydration queues them; the gtag.js bundle itself is loaded lazily after LCP. -->
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaMeasurementId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){window.dataLayer.push(arguments);}
        window.gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', wait_for_update: 500 });
        window.gtag('js', new Date());
        window.gtag('config', gaMeasurementId);

        function loadGtag() {
          if (window.__gtagLoaded) return;
          window.__gtagLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
          document.head.appendChild(s);
        }

        // Load gtag.js once the page is idle, or on first user interaction — whichever first.
        var onInteract = function () { loadGtag(); };
        var opts = { once: true, passive: true };
        ['pointerdown','keydown','scroll','touchstart'].forEach(function(ev){
          window.addEventListener(ev, onInteract, opts);
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGtag, { timeout: 4000 });
        } else {
          setTimeout(loadGtag, 3000);
        }
      </script>
    )}
    <!-- Fonts (non-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  </head>
  <body class="min-h-screen bg-warm-bg font-sans selection:bg-rb2-orange/30 selection:text-rb2-orange">
    <slot />

    <!-- Shared IntersectionObserver for .fade-in elements -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
    </script>

    <!-- PostHog init deferred to idle / first interaction so it doesn't compete
         with LCP. Consent state still gates capturing. Once initialised, fires
         a single site-wide seo_pageview event classified by referrer source +
         page category for SEO dashboards. -->
    <script>
      import type { PostHog } from 'posthog-js';
      import { getStoredConsent } from '../lib/cookieConsent';
      import { fireSeoPageview } from '../lib/seo-events';

      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      let started = false;

      async function startPostHog(): Promise<void> {
        if (started || !key) return;
        started = true;
        const { default: posthog } = await import('posthog-js');
        posthog.init(key, {
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com',
          debug: import.meta.env.PUBLIC_POSTHOG_DEBUG === 'true',
          opt_out_capturing_by_default: true,
          loaded: (client: PostHog) => {
            const consent = getStoredConsent();
            if (consent?.analytics) client.opt_in_capturing();
            // SEO pageview fires once per page load, after posthog is ready.
            // The helper internally tolerates no-consent (posthog swallows
            // captures while opt_out_capturing_by_default is true).
            fireSeoPageview();
          },
          persistence: 'localStorage+cookie',
          cross_subdomain_cookie: false,
          secure_cookie: true,
          property_denylist: ['$initial_referrer', '$initial_referring_domain'],
        });
      }

      // Kick off on first user interaction, or when the browser is idle — whichever first.
      const opts: AddEventListenerOptions = { once: true, passive: true };
      (['pointerdown', 'keydown', 'scroll', 'touchstart'] as const).forEach((ev) => {
        window.addEventListener(ev, () => void startPostHog(), opts);
      });
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void startPostHog(), { timeout: 4000 });
      } else {
        setTimeout(() => void startPostHog(), 3000);
      }
    </script>
  </body>
</html>
