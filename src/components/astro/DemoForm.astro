---
const benefits = [
  { label: '99.9% Accuracy', desc: 'Consistently across all formats.' },
  { label: '60-Second Processing', desc: 'From inbox to ERP.' },
  { label: 'Native Integration', desc: 'Business Central, Exact Online, Odoo, NetSuite, SAP.' }
];
---

<!-- Success View (hidden initially) -->
<section id="contact" class="py-20 lg:py-24 px-6 bg-card-white border-t border-gray-100 hidden" data-contact-form data-success-view>
  <div class="max-w-4xl mx-auto text-center animate-tabFadeIn">
    <div class="w-20 h-20 bg-green-accent/10 text-green-accent rounded-full flex items-center justify-center mx-auto mb-8">
      <!-- CheckCircle -->
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    </div>
    <h2 class="text-3xl md:text-4xl font-bold text-text-primary mb-4">Inquiry Received!</h2>
    <p class="text-text-secondary text-lg mb-8">
      We typically answer our enquiries within 24 hours to discuss your specific needs and see if OrderPilot is a good fit.
    </p>
    <button
      data-send-another
      class="text-rb2-orange font-bold hover:underline"
    >
      Send another inquiry
    </button>
  </div>
</section>

<!-- Form View -->
<section
  id="contact-form-section"
  class="py-20 lg:py-32 px-4 sm:px-6 lg:px-8 bg-card-white fade-in border-t border-gray-100"
  data-contact-form
  data-form-view
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-text-muted mb-4 block">/ GET IN TOUCH</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-text-primary mb-8">
          Talk to a procurement automation<br />
          <span class="font-serif italic text-rb2-orange">expert.</span>
        </h2>
        <p class="text-lg text-text-secondary mb-8 leading-relaxed">
          Get in touch with our team to discuss your purchase order processing challenges. We'll explore your specific needs and see if OrderPilot is the right solution.
        </p>
        <p class="text-lg text-text-secondary mb-12 leading-relaxed">
          No commitment. No pressure. Just a conversation about your procurement automation needs.
        </p>

        <div class="space-y-6 mb-12">
          {benefits.map((item) => (
            <div class="flex items-start gap-4">
              <div class="mt-1 p-1 bg-rb2-orange/10 text-rb2-orange rounded-full">
                <!-- CheckCircle 16 -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div>
                <div class="font-bold text-text-primary">{item.label}</div>
                <div class="text-sm text-text-secondary">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>

        <div class="flex items-center gap-4">
          <p class="text-sm text-text-secondary">Want to see the numbers first?</p>
          <a
            href="/calculator"
            class="text-rb2-orange font-bold hover:underline text-sm"
          >
            Calculate your costs &rarr;
          </a>
        </div>
        <p class="text-[10px] text-text-muted uppercase font-bold tracking-widest mt-2">See exactly what manual processing costs your company each year.</p>
      </div>

      <div class="bg-warm-bg rounded-[2.5rem] p-8 md:p-12 border border-gray-100 shadow-xl">
        <form data-submit-form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <label class="space-y-2 block">
              <span class="text-xs font-bold text-text-muted uppercase tracking-wider">First Name</span>
              <input
                type="text"
                name="firstName"
                required
                placeholder="First Name"
                class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all"
              />
            </label>
            <label class="space-y-2 block">
              <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Last Name</span>
              <input
                type="text"
                name="lastName"
                required
                placeholder="Last Name"
                class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all"
              />
            </label>
          </div>
          <label class="space-y-2 block">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Work Email</span>
            <input
              type="email"
              name="email"
              required
              placeholder="your.email@company.com"
              class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all"
            />
          </label>
          <label class="space-y-2 block">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Company Name</span>
            <input
              type="text"
              name="company"
              required
              placeholder="Acme Corp"
              class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all"
            />
          </label>
          <label class="space-y-2 block">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Monthly PO Volume</span>
            <select name="poVolume" class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all appearance-none">
              <option>100 - 500 orders</option>
              <option>500 - 2,000 orders</option>
              <option>2,000 - 10,000 orders</option>
              <option>10,000+ orders</option>
            </select>
          </label>
          <label class="space-y-2 block">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Message (Optional)</span>
            <textarea
              name="message"
              rows="4"
              placeholder="Tell us about your current PO processing challenges or specific questions you have..."
              class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all resize-none"
            ></textarea>
          </label>
          <div data-error class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm hidden"></div>
          <button
            type="submit"
            data-submit-btn
            class="w-full bg-rb2-orange text-white rounded-2xl font-bold py-4 hover:bg-rb2-orange-hover hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Get in Touch
            <!-- ArrowRight 18 -->
            <svg data-arrow-icon xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <p class="text-[10px] text-center text-text-muted font-bold uppercase tracking-widest">Free consultation. No obligation. No pressure.</p>
        </form>
      </div>
    </div>

    <div class="mt-24 pt-12 border-t border-gray-100 text-center max-w-4xl mx-auto">
      <p class="text-xl md:text-2xl font-serif italic text-text-primary md:whitespace-nowrap">
        OrderPilot. Purchase orders in. Clean data out. Your team back to real work.
      </p>
    </div>
  </div>
</section>

<script>
  import posthog from 'posthog-js';

  const formView = document.querySelector('[data-form-view]') as HTMLElement;
  const successView = document.querySelector('[data-success-view]') as HTMLElement;
  const form = document.querySelector('[data-submit-form]') as HTMLFormElement;
  const submitBtn = document.querySelector('[data-submit-btn]') as HTMLButtonElement;
  const arrowIcon = submitBtn?.querySelector('[data-arrow-icon]') as SVGElement;
  const errorDiv = document.querySelector('[data-error]') as HTMLElement;
  const sendAnotherBtn = document.querySelector('[data-send-another]') as HTMLButtonElement;

  // IntersectionObserver for tracking form visibility
  let formStarted = false;
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !formStarted) {
          posthog.capture('inquiry_form_started', {
            source_page: window.location.pathname
          });
          formStarted = true;
          observer.disconnect();
        }
      });
    },
    { threshold: 0.5 }
  );
  if (formView) observer.observe(formView);

  // Form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    if (arrowIcon) arrowIcon.classList.add('hidden');
    errorDiv.classList.add('hidden');

    const formData = new FormData(form);
    const firstName = formData.get('firstName') as string;
    const lastName = formData.get('lastName') as string;
    const email = formData.get('email') as string;
    const company = formData.get('company') as string;
    const poVolume = formData.get('poVolume') as string;
    const message = formData.get('message') as string;

    const userId = email;
    const companyId = `${company.toLowerCase().replace(/\s+/g, '-')}-${Date.now()}`;

    try {
      const apiBase = (import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');
      const response = await fetch(`${apiBase}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName, lastName, email, company, poVolume, message }),
      });

      if (!response.ok) throw new Error('Failed to submit form');

      posthog.identify(userId, {
        first_name: firstName,
        last_name: lastName,
        email: email,
        full_name: `${firstName} ${lastName}`,
      });

      posthog.group('company', companyId, {
        name: company,
        po_volume: poVolume,
        industry: 'unknown',
        size: poVolume,
      });

      posthog.capture('inquiry_form_completed', {
        company_size: poVolume,
        po_volume: poVolume,
        source_page: window.location.pathname,
      });

      // Show success, hide form
      formView.classList.add('hidden');
      successView.classList.remove('hidden');
    } catch (error) {
      const msg = error instanceof Error ? error.message : 'Unknown error';
      errorDiv.textContent = 'Failed to submit form. Please try again or email us directly at info@order-pilot.ai';
      errorDiv.classList.remove('hidden');

      posthog.capture('inquiry_form_error', {
        error_message: msg,
        source_page: window.location.pathname,
      });
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Get in Touch <svg data-arrow-icon xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
    }
  });

  // Send another inquiry
  sendAnotherBtn?.addEventListener('click', () => {
    successView.classList.add('hidden');
    formView.classList.remove('hidden');
    form.reset();
    errorDiv.classList.add('hidden');
  });
</script>
