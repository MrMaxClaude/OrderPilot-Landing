                  <p class="text-[12px] font-black text-gray-900">&euro;23,100.00</p>
                </div>
              </div>
            </div>
          </div>
          <p class="text-sm font-medium text-gray-400 text-center mt-4">Extracted data</p>
        </div>

        <!-- Mobile Card 5: Validated -->
        <div class="snap-center flex-shrink-0 flex flex-col items-center">
          <div class="w-64 h-80 bg-white rounded-xl shadow-md border-2 border-[#FF4500]/30 shadow-lg p-5">
