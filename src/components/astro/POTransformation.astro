                    <p class="text-[9px] uppercase tracking-wider text-[#FF4500]/70 font-bold">Customer</p>
                    <p class="text-[11px] font-bold text-gray-800">VDL Industrial Modules</p>
                  </div>
                </div>
                <div class="flex justify-between items-start mt-2 px-1.5">
                  <div>
                    <p class="text-[9px] uppercase tracking-wider text-gray-400">PO Number</p>
                    <p class="text-[11px] font-bold text-[#FF4500]">PO-2024-0591</p>
