              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#FF4500]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#FF4500]">VALIDATED</span>
            </div>
            <div class="scale-110 origin-top-left">
              <div class="space-y-1 relative">
                <div class="flex items-center gap-2 mb-2">
                  <div class="h-1 flex-1 bg-[#FF4500]/10 rounded-full overflow-hidden">
