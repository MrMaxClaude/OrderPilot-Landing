---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-text-muted">
  <ol class="flex flex-wrap items-center gap-2">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <svg
              class="w-3.5 h-3.5 text-text-muted/60"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          )}
          {c.href ? (
            <a
              href={c.href}
              class="hover:text-rb2-orange transition-colors font-medium"
            >
              {c.label}
            </a>
          ) : (
            <span class="text-text-primary font-semibold" aria-current="page">
              {c.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
