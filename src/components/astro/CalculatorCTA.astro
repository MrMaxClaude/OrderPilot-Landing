---
---

<!-- Expanded CTA -->
<div data-calculator-cta class="fixed bottom-0 left-0 right-0 sm:bottom-8 sm:right-8 sm:left-auto z-50 max-w-full sm:max-w-md cta-enter hidden">
  <a
    href="/calculator"
    class="block bg-gradient-to-br from-white to-[#FFF9F5] rounded-t-2xl sm:rounded-2xl shadow-2xl border border-gray-100/80 border-l-4 border-l-rb2-orange p-6 sm:p-9 relative hover:shadow-3xl hover:-translate-y-1 transition-all duration-300 cursor-pointer group overflow-hidden backdrop-blur-sm sm:backdrop-blur-none bg-white/95 sm:bg-transparent"
  >
    <!-- Decorative element -->
    <div class="absolute -top-6 -right-6 rotate-12 group-hover:rotate-0 transition-transform duration-700 opacity-[0.08]">
      <img
        src="/logo.svg"
        alt=""
        class="w-48 h-48 object-contain"
        referrerpolicy="no-referrer"
      />
    </div>

    <!-- Minimize button -->
    <button
      data-minimize
      class="absolute top-4 right-4 text-gray-200 hover:text-gray-400 transition-colors z-20"
    >
      <!-- X icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    <div class="flex flex-row sm:flex-col items-center sm:items-start justify-between sm:justify-start gap-4 sm:gap-0">
      <div class="flex-1">
        <!-- Eyebrow - Desktop only -->
        <p class="hidden sm:block text-[10px] font-bold tracking-[0.2em] text-rb2-orange/70 uppercase mb-4">
          / Free calculator
        </p>

        <h3 class="text-lg sm:text-2xl font-[800] text-gray-900 leading-[1.3] mb-1 sm:mb-3">
          What's <span class="font-serif italic text-rb2-orange">the real cost</span> of processing POs by hand?
        </h3>

        <!-- Subtext - Desktop only -->
        <p class="hidden sm:block text-sm text-gray-400 mb-5">
          7 questions. 2 minutes. Find your number.
        </p>
      </div>

      <div
        class="flex-shrink-0 sm:flex-shrink sm:inline-flex items-center px-4 py-2 bg-rb2-orange/10 text-rb2-orange rounded-full font-bold text-sm hover:bg-rb2-orange hover:text-white transition-all group-hover:shadow-lg group-hover:shadow-orange-200/50"
      >
        Calculate now
        <!-- ArrowRight icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
    </div>

    <!-- Mobile safe area padding -->
    <div class="sm:hidden pb-safe"></div>
  </a>
</div>

<!-- Minimized CTA -->
<div data-calculator-cta-mini class="fixed bottom-6 right-6 z-50 cta-enter hidden">
  <button
    data-expand
    class="flex items-center gap-3 bg-white hover:bg-[#FFF9F5] rounded-full shadow-xl border border-gray-100 p-3 px-5 cursor-pointer transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 group border-l-4 border-l-rb2-orange"
  >
    <div class="w-8 h-8 rounded-full bg-rb2-orange/10 flex items-center justify-center text-rb2-orange group-hover:bg-rb2-orange group-hover:text-white transition-all duration-300">
      <!-- Calculator icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
    </div>
    <span class="text-sm font-bold text-gray-900 pr-1">Calculate your costs</span>
  </button>
</div>

<script>
  const expanded = document.querySelector('[data-calculator-cta]') as HTMLElement;
  const minimized = document.querySelector('[data-calculator-cta-mini]') as HTMLElement;
  const minimizeBtn = document.querySelector('[data-minimize]') as HTMLButtonElement;
  const expandBtn = document.querySelector('[data-expand]') as HTMLButtonElement;

  if (expanded && minimized) {
    const isCalculatorPage = window.location.pathname === '/calculator';

    if (!isCalculatorPage) {
      let shown = false;

      function show() {
        if (shown) return;
        shown = true;
        expanded.classList.remove('hidden');
      }

      // Show after 5s or 40% scroll
      void setTimeout(show, 5000);

      function handleScroll() {
        const scrollPercent = window.scrollY / (document.body.scrollHeight - window.innerHeight);
        if (scrollPercent > 0.4) show();
      }
      window.addEventListener('scroll', handleScroll, { passive: true });

      // Minimize
      minimizeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        expanded.classList.add('hidden');
        minimized.classList.remove('hidden');
      });

      // Expand
      expandBtn.addEventListener('click', () => {
        minimized.classList.add('hidden');
        expanded.classList.remove('hidden');
      });
    }
  }
</script>
