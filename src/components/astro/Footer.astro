---
import Logo from './Logo.astro';
---

<footer class="bg-text-primary text-white py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-[1400px] mx-auto">
    <div class="mb-12 grid grid-cols-1 gap-10 lg:grid-cols-4 lg:items-start lg:gap-x-6 lg:gap-y-0 xl:gap-x-10">
      <div class="min-w-0">
        <a href="/" class="mb-6 block hover:opacity-80 transition-opacity">
          <Logo size={48} />
        </a>
        <p class="text-white/60 text-sm leading-relaxed">
          The world&apos;s most accurate purchase order processing platform. Built for procurement
          teams that demand 100% accuracy.
        </p>
      </div>

      <div class="min-w-0">
        <h4 class="text-xs font-bold uppercase tracking-widest mb-6">Product</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/#benefits" class="text-white/60 hover:text-white transition-colors">Benefits</a></li>
          <li><a href="/#how-it-works" class="text-white/60 hover:text-white transition-colors">How it Works</a></li>
          <li><a href="/#results" class="text-white/60 hover:text-white transition-colors">Results</a></li>
          <li><a href="/pricing" class="text-white/60 hover:text-white transition-colors">Pricing</a></li>
          <li><a href="/knowledge-base/" class="text-white/60 hover:text-white transition-colors">Knowledge base</a></li>
        </ul>
      </div>

      <div class="min-w-0">
        <h4 class="text-xs font-bold uppercase tracking-widest mb-6">Industry solutions</h4>
        <ul class="space-y-4 text-sm">
          <li>
            <a href="/purchase-order-automation-manufacturing/" class="text-white/60 hover:text-white transition-colors"
              >Manufacturing PO automation</a
            >
          </li>
          <li>
            <a href="/purchase-order-automation-distribution/" class="text-white/60 hover:text-white transition-colors"
              >Distribution &amp; wholesale</a
            >
          </li>
          <li>
            <a href="/purchase-order-automation-sap/" class="text-white/60 hover:text-white transition-colors">SAP</a>
          </li>
          <li>
            <a href="/purchase-order-automation-afas/" class="text-white/60 hover:text-white transition-colors">AFAS</a>
          </li>
          <li>
            <a href="/po-processing-software-mid-market/" class="text-white/60 hover:text-white transition-colors"
              >Mid-market PO software</a
            >
          </li>
        </ul>
      </div>

      <div class="min-w-0">
        <h4 class="text-xs font-bold uppercase tracking-widest mb-6">Legal</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/privacy" class="text-white/60 hover:text-white transition-colors">Privacy Policy</a></li>
          <li>
            <button
              type="button"
              id="open-cookie-settings"
              class="text-white/60 hover:text-white transition-colors text-left w-full"
            >
              Cookie settings
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] font-bold uppercase tracking-widest text-white/40">
      <p>&copy; 2026 ORDERPILOT BY RB2. ALL RIGHTS RESERVED.</p>
      <div class="flex items-center gap-8">
        <span>ISO 27001 CERTIFIED</span>
        <span>GDPR COMPLIANT</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { requestOpenCookieConsent } from '../../lib/cookieConsent';

  document.getElementById('open-cookie-settings')?.addEventListener('click', () => {
    requestOpenCookieConsent();
  });
</script>
