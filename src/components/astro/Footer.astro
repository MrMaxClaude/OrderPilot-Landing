---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';

const footerData = await getEntry('footer', 'default');
if (!footerData) throw new Error('Missing content: footer/default.json');
const { tagline, linkGroups, copyright, complianceLabels } = footerData.data;
---

<footer class="bg-text-primary text-white py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-[1400px] mx-auto">
    <div class="mb-12 grid grid-cols-1 gap-10 lg:grid-cols-4 lg:items-start lg:gap-x-6 lg:gap-y-0 xl:gap-x-10">
      <div class="min-w-0">
        <a href="/" class="mb-6 block hover:opacity-80 transition-opacity">
          <Logo size={48} />
        </a>
        <p class="text-white/60 text-sm leading-relaxed">
          {tagline}
        </p>
      </div>

      {
        linkGroups.map((group, gi) => (
          <div class="min-w-0">
            <h3 class="text-xs font-bold uppercase tracking-widest mb-6">{group.heading}</h3>
            <ul class="space-y-4 text-sm">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-white/60 hover:text-white transition-colors"
                  >
                    {link.text}
                  </a>
                </li>
              ))}
              {/* The cookie settings button is appended to the Legal group for GDPR UX */}
              {gi === linkGroups.length - 1 && group.heading.toLowerCase().includes('legal') && (
                <li>
                  <button
                    type="button"
                    id="open-cookie-settings"
                    class="text-white/60 hover:text-white transition-colors text-left w-full"
                  >
                    Cookie settings
                  </button>
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] font-bold uppercase tracking-widest text-white/40">
      <p>{copyright}</p>
      <div class="flex items-center gap-8">
        {complianceLabels.map((label) => <span>{label}</span>)}
      </div>
    </div>
  </div>
</footer>

<script>
  import { requestOpenCookieConsent } from '../../lib/cookieConsent';

  document.getElementById('open-cookie-settings')?.addEventListener('click', () => {
    requestOpenCookieConsent();
  });
</script>
