---
---

<section class="py-24 lg:py-32 bg-warm-bg-alt fade-in">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-text-muted mb-4 block">
        / CUSTOMER SUCCESS
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary mb-6">
        How IPN Saves <span class="font-serif italic text-rb2-orange">2,400 Hours</span> Per Year
      </h2>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto leading-relaxed">
        Leading animal feed manufacturer transforms procurement operations with AI-powered automation
      </p>
    </div>

    <!-- Company Logo & Info -->
    <div class="bg-white rounded-[2.5rem] p-12 mb-16 border border-gray-100 shadow-sm">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center space-x-4 mb-6">
            <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center p-2 border border-gray-200">
              <img
                src="/ipn-nutrition-logo-1563350225.jpg"
                alt="IPN Logo"
                class="w-full h-full object-contain grayscale opacity-70"
              />
            </div>
            <div>
              <h3 class="text-2xl font-bold text-text-primary">IPN Pet Food</h3>
              <p class="text-text-muted font-medium">Premium Animal Feed Manufacturer</p>
            </div>
          </div>
          <div class="space-y-4 text-text-secondary">
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-rb2-orange rounded-full mt-2"></div>
              <p><strong>Industry:</strong> Animal Feed &amp; Pet Food Manufacturing</p>
            </div>
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-rb2-orange rounded-full mt-2"></div>
              <p><strong>Location:</strong> Netherlands</p>
            </div>
            <div class="flex items-start space-x-3">
              <div class="w-2 h-2 bg-rb2-orange rounded-full mt-2"></div>
              <p><strong>Volume:</strong> 1,200+ purchase orders monthly</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="bg-gradient-to-br from-rb2-orange/10 to-amber-accent/10 rounded-3xl p-8 border border-rb2-orange/20">
            <!-- Quote icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange mb-4"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"/></svg>
            <blockquote class="text-lg font-medium text-text-primary leading-relaxed mb-4 italic">
              &ldquo;OrderPilot has transformed how we handle procurement. What used to take our team 30 minutes per order now happens automatically in under 2 minutes. It's given us our time back to focus on what really matters.&rdquo;
            </blockquote>
            <div class="flex items-center space-x-3">
              <div class="w-12 h-12 bg-gradient-to-br from-gray-200 to-gray-300 rounded-full"></div>
              <div>
                <p class="font-bold text-text-primary">Procurement Director</p>
                <p class="text-sm text-text-muted">IPN Pet Food</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- The Challenge -->
    <div class="grid lg:grid-cols-2 gap-16 mb-20">
      <div>
        <div class="sticky top-8">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-text-muted mb-4 block">
            THE CHALLENGE
          </span>
          <h3 class="text-3xl md:text-4xl font-bold text-text-primary mb-6">
            Manual Processing <span class="font-serif italic text-rb2-orange">Bottleneck</span>
          </h3>
          <p class="text-lg text-text-secondary leading-relaxed">
            With over 1,200 purchase orders flowing through email monthly, IPN's procurement team was drowning in manual data entry. Each order required 20-30 minutes of careful transcription from supplier emails into their ERP system.
          </p>
        </div>
      </div>

      <div class="space-y-8">
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gray-50 rounded-2xl flex items-center justify-center border border-gray-200">
              <div class="w-6 h-6 border-2 border-gray-400 rounded-full relative">
                <div class="absolute top-0.5 left-1/2 w-0.5 h-2 bg-gray-400 transform -translate-x-1/2"></div>
                <div class="absolute top-1.5 left-1/2 w-1.5 h-0.5 bg-gray-400 transform -translate-x-1/2"></div>
              </div>
            </div>
            <div>
              <h4 class="font-bold text-text-primary mb-2">Time-Intensive Process</h4>
              <p class="text-text-secondary">30+ minutes per order for manual data entry and validation</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gray-50 rounded-2xl flex items-center justify-center border border-gray-200">
              <div class="grid grid-cols-3 gap-0.5 w-5 h-5">
                <div class="w-1.5 h-1.5 bg-gray-400 rounded-full"></div>
                <div class="w-1.5 h-1.5 bg-gray-400 rounded-full"></div>
                <div class="w-1.5 h-1.5 bg-gray-400 rounded-full"></div>
              </div>
            </div>
            <div>
              <h4 class="font-bold text-text-primary mb-2">Resource Drain</h4>
              <p class="text-text-secondary">3 full-time staff members dedicated solely to PO processing</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 bg-gray-50 rounded-2xl flex items-center justify-center border border-gray-200">
              <div class="flex flex-col space-y-0.5 w-5 h-5">
                <div class="flex space-x-0.5">
                  <div class="w-1 h-1 bg-gray-400"></div>
                  <div class="w-1.5 h-1 bg-gray-400"></div>
                  <div class="w-1 h-1 bg-gray-400"></div>
                </div>
                <div class="flex space-x-0.5">
                  <div class="w-0.5 h-1 bg-gray-400"></div>
                  <div class="w-2 h-1 bg-gray-400"></div>
                  <div class="w-1.5 h-1 bg-gray-400"></div>
                </div>
                <div class="flex space-x-0.5">
                  <div class="w-1.5 h-1 bg-gray-400"></div>
                  <div class="w-1 h-1 bg-gray-400"></div>
                  <div class="w-1.5 h-1 bg-gray-400"></div>
                </div>
              </div>
            </div>
            <div>
              <h4 class="font-bold text-text-primary mb-2">Scaling Challenges</h4>
              <p class="text-text-secondary">Growing order volume making manual process unsustainable</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Results Metrics -->
    <div class="bg-gradient-to-br from-text-primary to-gray-800 rounded-[2.5rem] p-12 lg:p-16 mb-16 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute bottom-8 right-8 opacity-10">
        <img
          src="/logo.svg"
          alt="OrderPilot Icon"
          class="w-32 h-32"
        />
      </div>

      <div class="relative z-10">
        <div class="text-center mb-12">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-rb2-orange mb-4 block">
            MEASURABLE IMPACT
          </span>
          <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Transformation by the <span class="font-serif italic text-rb2-orange">Numbers</span>
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Metric 1: Time Saved -->
          <div class="text-center">
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-4">
              <!-- Clock icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange mx-auto mb-4"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div class="text-4xl font-black text-white mb-1">2,400</div>
              <div class="text-rb2-orange font-bold text-sm mb-3 uppercase tracking-wider">hours/year</div>
              <div class="text-lg font-bold text-white mb-2">Time Saved</div>
              <div class="text-sm text-gray-300 leading-relaxed">Previously spent on manual PO processing</div>
            </div>
          </div>

          <!-- Metric 2: Processing Time -->
          <div class="text-center">
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-4">
              <!-- TrendingUp icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange mx-auto mb-4"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              <div class="text-4xl font-black text-white mb-1">95%</div>
              <div class="text-rb2-orange font-bold text-sm mb-3 uppercase tracking-wider">reduction</div>
              <div class="text-lg font-bold text-white mb-2">Processing Time</div>
              <div class="text-sm text-gray-300 leading-relaxed">From 30 minutes to under 2 minutes per order</div>
            </div>
          </div>

          <!-- Metric 3: Data Quality -->
          <div class="text-center">
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-4">
              <!-- CheckCircle icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange mx-auto mb-4"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
              <div class="text-4xl font-black text-white mb-1">99.8%</div>
              <div class="text-rb2-orange font-bold text-sm mb-3 uppercase tracking-wider">accuracy</div>
              <div class="text-lg font-bold text-white mb-2">Data Quality</div>
              <div class="text-sm text-gray-300 leading-relaxed">Elimination of manual entry errors</div>
            </div>
          </div>

          <!-- Metric 4: Resources Freed -->
          <div class="text-center">
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 mb-4">
              <!-- Users icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange mx-auto mb-4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <div class="text-4xl font-black text-white mb-1">3</div>
              <div class="text-rb2-orange font-bold text-sm mb-3 uppercase tracking-wider">FTE</div>
              <div class="text-lg font-bold text-white mb-2">Resources Freed</div>
              <div class="text-sm text-gray-300 leading-relaxed">Team members redirected to strategic work</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Implementation Journey -->
    <div class="grid lg:grid-cols-3 gap-8 mb-16">
      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 mb-6">
          <span class="font-bold text-xl">1</span>
        </div>
        <h4 class="text-xl font-bold text-text-primary mb-4">Setup &amp; Integration</h4>
        <p class="text-text-secondary leading-relaxed">
          Connected OrderPilot to IPN's email system and Business Central ERP in under 48 hours with zero downtime.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center text-green-600 mb-6">
          <span class="font-bold text-xl">2</span>
        </div>
        <h4 class="text-xl font-bold text-text-primary mb-4">AI Training &amp; Testing</h4>
        <p class="text-text-secondary leading-relaxed">
          Trained the AI on IPN's specific supplier formats and product codes, achieving 99.8% accuracy within the first week.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
        <div class="w-12 h-12 bg-rb2-orange/10 rounded-xl flex items-center justify-center text-rb2-orange mb-6">
          <span class="font-bold text-xl">3</span>
        </div>
        <h4 class="text-xl font-bold text-text-primary mb-4">Full Deployment</h4>
        <p class="text-text-secondary leading-relaxed">
          Rolled out across all procurement workflows, with staff retrained to focus on exception handling and strategic tasks.
        </p>
      </div>
    </div>

    <!-- ROI Section -->
    <div class="bg-green-50 rounded-[2.5rem] p-12 border border-green-200/50">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-green-600 mb-4 block">
            RETURN ON INVESTMENT
          </span>
          <h3 class="text-3xl font-bold text-text-primary mb-6">
            Payback in <span class="font-serif italic font-bold text-rb2-orange">3.2 Months</span>
          </h3>
          <p class="text-lg text-text-secondary leading-relaxed mb-6">
            With 2,400 hours saved annually at an average cost of &euro;45/hour, IPN achieved an ROI of 380% in the first year alone.
          </p>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-text-secondary">Annual labor cost saved:</span>
              <span class="font-bold text-text-primary">&euro;108,000</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-text-secondary">OrderPilot annual cost:</span>
              <span class="font-bold text-text-primary">&euro;28,500</span>
            </div>
            <div class="h-px bg-gray-200 my-2"></div>
            <div class="flex justify-between items-center text-lg">
              <span class="font-bold text-text-primary">Net savings:</span>
              <span class="font-bold text-green-600">&euro;79,500/year</span>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="bg-white rounded-3xl p-8 shadow-lg">
            <div class="text-center">
              <div class="text-5xl font-black text-green-600 mb-2">380%</div>
              <div class="text-lg font-bold text-text-primary mb-4">First Year ROI</div>
              <div class="h-2 bg-green-100 rounded-full overflow-hidden">
                <div class="h-full bg-green-500 w-full rounded-full"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <h3 class="text-2xl md:text-3xl font-bold text-text-primary mb-6">
        Ready to Transform Your <span class="font-serif italic text-rb2-orange">Procurement?</span>
      </h3>
      <p class="text-lg text-text-secondary mb-8 max-w-2xl mx-auto">
        See how OrderPilot can deliver similar results for your business. Talk to our experts about your specific needs.
      </p>
      <a href="/#contact" class="inline-flex items-center px-10 py-5 bg-rb2-orange text-white rounded-2xl font-bold text-lg hover:bg-rb2-orange-hover hover:shadow-2xl hover:shadow-orange-200/50 transition-all hover:-translate-y-1">
        Get Your Custom ROI Analysis
        <!-- ArrowRight icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-3"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
