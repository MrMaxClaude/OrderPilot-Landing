---
interface Badge {
  label: string;
  icon: string;
}

interface Props {
  headline: string;
  description: string;
  badges: Badge[];
  quote: string;
  quoteAuthor: string;
  quoteRole: string;
}

const { headline, description, badges, quote, quoteAuthor, quoteRole } = Astro.props;

const iconMap: Record<string, string> = {
  shield: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>',
  lock: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
  'check-circle': '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>',
};
---

<section class="py-16 bg-card-white border-y border-gray-100 fade-in">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-3xl font-bold text-text-primary mb-6">
          Enterprise-Grade <span class="font-serif italic text-rb2-orange">Security</span>
        </h2>
        <p class="text-text-secondary mb-8 leading-relaxed">
          {description}
        </p>
        <div class="grid grid-cols-2 gap-4">
          {badges.map((badge) => (
            <div class="p-4 bg-warm-bg rounded-xl border border-gray-100 flex items-center gap-3">
              <Fragment set:html={iconMap[badge.icon] || iconMap['shield']} />
              <span class="text-sm font-bold text-text-primary">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="bg-text-primary rounded-3xl p-8 md:p-12 text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-rb2-orange/20 rounded-full -mr-32 -mt-32 blur-3xl"></div>
        <div class="relative z-10">
          <p class="text-xl font-serif italic mb-8">
            &ldquo;{quote}&rdquo;
          </p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white/10 rounded-full"></div>
            <div>
              <div class="font-bold">{quoteAuthor}</div>
              <div class="text-xs text-white/60 uppercase tracking-widest">{quoteRole}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
