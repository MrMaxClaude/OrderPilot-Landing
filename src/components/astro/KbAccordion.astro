---
interface Props {
  /** Heading shown on the closed summary. Required. */
  title: string;
  /** Optional short one-liner shown next to the heading. */
  hint?: string;
  /** Open by default. */
  open?: boolean;
}

const { title, hint, open = false } = Astro.props;
---

<details
  class="kb-accordion not-prose my-4 group rounded-2xl border border-gray-100 bg-card-white shadow-sm open:border-rb2-orange/40 open:shadow-md transition-colors"
  open={open}
>
  <summary class="w-full text-left px-5 py-4 flex items-start justify-between gap-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <span class="flex-1">
      <span class="block text-[15px] font-bold text-text-primary group-open:text-rb2-orange transition-colors leading-snug">
        {title}
      </span>
      {hint && (
        <span class="block text-xs text-text-muted mt-0.5 leading-snug">{hint}</span>
      )}
    </span>
    <svg
      class="w-5 h-5 mt-0.5 text-rb2-orange shrink-0 transition-transform group-open:rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class="px-5 pb-5 pt-2 text-sm text-text-secondary leading-relaxed border-t border-gray-100 kb-accordion-body">
    <slot />
  </div>
</details>
