---
import Logo from './Logo.astro';

const params = Astro.url.searchParams;
const savings = params.get('savings') || '';
const company = params.get('company') || 'Your Company';
const erp = params.get('erp') || 'your ERP';
---

<div class="min-h-screen bg-warm-bg">
  <!-- Form View -->
  <div data-form-view>
    <!-- Header -->
    <header class="px-6 py-6 border-b border-gray-100">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center">
          <Logo size={32} />
          <span class="ml-3 text-xl font-bold text-gray-900">OrderPilot</span>
        </a>
        <div class="flex items-center gap-4">
          <span class="text-sm text-gray-500">From your PDF report</span>
          <div class="w-2 h-2 bg-green-500 rounded-full"></div>
        </div>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Left Column - Value Prop -->
        <div>
          <div class="mb-6">
            <span class="inline-block bg-rb2-orange/10 text-rb2-orange px-3 py-1 rounded-full text-sm font-bold uppercase tracking-wide">
              Hot Lead Priority
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
            Ready to save {savings ? (
              <span class="text-rb2-orange">{savings}/year?</span>
            ) : (
              <span class="text-rb2-orange">thousands per year?</span>
            )}
          </h1>

          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            You've seen the numbers from your cost analysis. Now see exactly how OrderPilot
            eliminates 90% of your manual PO processing work.
          </p>

          <!-- Social Proof -->
          <div class="bg-white rounded-3xl p-8 mb-8 shadow-sm border border-gray-100">
            <div class="flex items-center gap-4 mb-6">
              <div class="flex items-center">
                {[1,2,3,4,5].map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-400">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                ))}
              </div>
              <span class="text-sm font-semibold text-gray-600">4.9/5 from 200+ implementations</span>
            </div>

            <blockquote class="text-gray-700 mb-4">
              "OrderPilot saved us €47,000 in the first year. Our team went from spending 15 hours/week
              on PO processing to just 2 hours reviewing exceptions."
            </blockquote>
            <cite class="text-sm text-gray-500">
              — Sarah Chen, Operations Director at MidCorp Manufacturing (320 employees)
            </cite>
          </div>

          <!-- Benefits -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <div class="flex items-start gap-3">
              <div class="p-2 bg-rb2-orange/10 text-rb2-orange rounded-lg">
                <!-- Clock -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <div class="font-bold text-gray-900 text-sm">Fast Setup</div>
                <div class="text-xs text-gray-600">Live in 14 days</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="p-2 bg-rb2-orange/10 text-rb2-orange rounded-lg">
                <!-- Shield -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <div class="font-bold text-gray-900 text-sm">Risk-Free</div>
                <div class="text-xs text-gray-600">30-day money-back guarantee</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="p-2 bg-rb2-orange/10 text-rb2-orange rounded-lg">
                <!-- Users -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <div class="font-bold text-gray-900 text-sm">Expert Support</div>
                <div class="text-xs text-gray-600">Dedicated success manager</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="p-2 bg-rb2-orange/10 text-rb2-orange rounded-lg">
                <!-- CheckCircle -->
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div>
                <div class="font-bold text-gray-900 text-sm">99.9% Accuracy</div>
                <div class="text-xs text-gray-600">Proven across 500K+ POs</div>
              </div>
            </div>
          </div>

          <!-- Urgency -->
          <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6">
            <div class="flex items-start gap-3">
              <!-- Clock -->
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-600 mt-1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <h4 class="font-bold text-yellow-800 mb-2">Limited Time: Q1 Implementation Bonus</h4>
                <p class="text-sm text-yellow-700">
                  Start before March 31st and get 3 months free implementation support
                  (€4,500 value). Only 12 spots remaining.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column - Demo Form -->
        <div class="bg-gray-900 rounded-[2.5rem] p-8 md:p-12 shadow-2xl">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
              Book Your <span class="text-rb2-orange">Personalized Demo</span>
            </h2>
            <p class="text-gray-400">
              See OrderPilot process your actual PO formats in your {erp} system.
              20-minute call, no commitment required.
            </p>
          </div>

          <form data-demo-form class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                  First Name
                </label>
                <input
                  type="text"
                  name="firstName"
                  required
                  placeholder="First Name"
                  class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all placeholder-gray-500"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                  Last Name
                </label>
                <input
                  type="text"
                  name="lastName"
                  required
                  placeholder="Last Name"
                  class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all placeholder-gray-500"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                Work Email
              </label>
              <input
                type="email"
                name="email"
                required
                placeholder="your.email@company.com"
                class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all placeholder-gray-500"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                Phone Number
              </label>
              <input
                type="tel"
                name="phone"
                required
                placeholder="+31 6 1234 5678"
                class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all placeholder-gray-500"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                Implementation Timeline
              </label>
              <select
                name="urgency"
                required
                class="w-full bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:border-rb2-orange focus:ring-1 focus:ring-rb2-orange outline-none transition-all appearance-none"
              >
                <option value="">Select timeline</option>
                <option value="asap">ASAP (within 30 days)</option>
                <option value="q1">This quarter (within 90 days)</option>
                <option value="h1">This half-year (within 6 months)</option>
                <option value="evaluating">Just evaluating options</option>
              </select>
            </div>

            <button
              type="submit"
              class="w-full bg-rb2-orange text-white rounded-2xl font-bold py-4 hover:bg-rb2-orange-hover hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2"
            >
              Book My Demo Now
              <!-- ArrowRight -->
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>

            <p class="text-xs text-center text-gray-500">
              Free consultation &bull; No pressure &bull; We'll call you within 2 hours
            </p>
          </form>

          <div class="mt-8 pt-6 border-t border-gray-800">
            <div class="flex items-center justify-center gap-4 text-xs text-gray-500">
              <span>&#128274; Your data is secure</span>
              <span>&bull;</span>
              <span>&#128222; Expert will call you</span>
              <span>&bull;</span>
              <span>&#9889; 20-min demo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="mt-20 text-center">
        <p class="text-gray-500 mb-4">
          Not ready for a demo yet?{' '}
          <a href="/#contact" class="text-rb2-orange font-bold hover:underline">
            Just get in touch &rarr;
          </a>
        </p>
        <p class="text-xs text-gray-400">
          Based on your PDF analysis: {company} &bull; {erp} &bull; {savings ? `Potential savings: ${savings}` : 'Custom analysis completed'}
        </p>
      </div>
    </div>
  </div>

  <!-- Success View -->
  <div data-success-view hidden class="min-h-screen bg-warm-bg flex items-center justify-center px-6">
    <div class="max-w-lg mx-auto text-center animate-fadeIn">
      <div class="w-20 h-20 bg-green-500/10 text-green-500 rounded-full flex items-center justify-center mx-auto mb-8">
        <!-- CheckCircle -->
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h2 class="text-3xl font-bold text-gray-900 mb-4">Demo Booked Successfully!</h2>
      <p class="text-gray-600 text-lg mb-6 leading-relaxed">
        Our OrderPilot expert will call you within the next 2 hours to schedule your personalized demo.
      </p>
      <div class="bg-rb2-orange/10 border border-rb2-orange/30 rounded-2xl p-6 mb-8">
        <p class="text-sm text-gray-700">
          <strong>Next steps:</strong> We'll show you exactly how OrderPilot processes POs in your {erp} format
          and demonstrate the {savings} annual savings you calculated.
        </p>
      </div>
      <a href="/" class="text-rb2-orange font-bold hover:underline">
        &larr; Back to OrderPilot homepage
      </a>
    </div>
  </div>
</div>

<script>
  import posthog from 'posthog-js';

  const formView = document.querySelector<HTMLElement>('[data-form-view]')!;
  const successView = document.querySelector<HTMLElement>('[data-success-view]')!;
  const form = document.querySelector<HTMLFormElement>('[data-demo-form]')!;

  // Read URL params client-side for tracking
  const params = new URLSearchParams(window.location.search);
  const savings = params.get('savings') || '';
  const company = params.get('company') || 'Your Company';
  const erp = params.get('erp') || 'your ERP';

  // Track page view
  posthog.capture('pdf_demo_page_viewed', {
    savings,
    company,
    erp,
    source: 'pdf_report',
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const firstName = data.get('firstName') as string;
    const lastName = data.get('lastName') as string;
    const email = data.get('email') as string;
    const phone = data.get('phone') as string;
    const urgency = data.get('urgency') as string;

    posthog.identify(email, {
      first_name: firstName,
      last_name: lastName,
      email,
      phone,
      company_name: company,
      estimated_savings: savings,
      erp_system: erp,
      lead_source: 'pdf_report',
      urgency_level: urgency,
    });

    posthog.capture('pdf_demo_form_completed', {
      email,
      company,
      estimated_savings: savings,
      erp_system: erp,
      urgency_level: urgency,
      source: 'pdf_report',
    });

    formView.setAttribute('hidden', '');
    successView.removeAttribute('hidden');
  });
</script>
