---
interface Props {
  headline: string;
  logos: { name: string; url: string }[];
  quote: string;
  quoteAuthor: string;
  quoteRole: string;
  quoteAvatar?: string;
}

const { headline, logos, quote, quoteAuthor, quoteRole, quoteAvatar } = Astro.props;
---

<div class="max-w-7xl mx-auto px-6">
  <div class="text-center mb-16">
    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-[0.3em] mb-4">{headline}</h3>
  </div>

  <div class="flex flex-wrap justify-center items-center gap-x-16 gap-y-12 opacity-40 grayscale hover:grayscale-0 transition-all duration-700">
    {logos.map((logo) => (
      <div class="h-10 md:h-12 flex items-center transition-transform duration-200 hover:scale-110 hover:opacity-100">
        <img src={logo.url} alt={logo.name} class="h-full object-contain" referrerpolicy="no-referrer" />
      </div>
    ))}
  </div>

  <div class="mt-24 text-center bg-white p-12 rounded-[3rem] border border-gray-100 shadow-xl max-w-4xl mx-auto relative overflow-hidden fade-in">
    <div class="absolute top-0 left-0 w-2 h-full bg-rb2-orange"></div>
    <p class="text-2xl md:text-3xl font-serif font-medium text-gray-900 leading-relaxed mb-10 italic">
      &ldquo;{quote}&rdquo;
    </p>
    <div class="flex items-center justify-center space-x-4">
      {quoteAvatar && <img src={quoteAvatar} alt="Avatar" class="w-14 h-14 rounded-2xl shadow-lg" referrerpolicy="no-referrer" />}
      <div class="text-left">
        <p class="text-lg font-bold text-gray-900 leading-none">{quoteAuthor}</p>
        <p class="text-sm text-gray-400 mt-1 uppercase tracking-widest font-bold">{quoteRole}</p>
      </div>
    </div>
  </div>
</div>
