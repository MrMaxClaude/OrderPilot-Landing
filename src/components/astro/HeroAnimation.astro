---
// Pure Astro component - all animation driven by client-side <script>
---

<!-- Tailwind safelist: classes used dynamically in script innerHTML
     text-[#FF4500] text-blue-600 text-emerald-600
     bg-orange-50 bg-blue-50 bg-emerald-50
-->
<div class="w-full max-w-6xl mx-auto mt-12" id="hero-animation">
  <!-- is:global + #hero-animation: classes below apply to JS-created nodes (no data-astro-cid).
       Scoped Astro CSS would otherwise only match static markup, breaking slide + particle motion. -->
  <style is:global>
    @keyframes op-hero-slideToCenter {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(784px);
      }
    }
    #hero-animation .document-sliding {
      animation: op-hero-slideToCenter 3s linear forwards;
    }
    @keyframes op-hero-linePulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 1; box-shadow: 0 0 12px rgba(255, 69, 0, 0.4); }
    }
    #hero-animation .line-pulse {
      animation: op-hero-linePulse 2s ease-in-out infinite;
    }
    @keyframes op-hero-particleFly {
      0% {
        transform: translate(0, 0) scale(1) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translate(var(--endX), var(--endY)) scale(0) rotate(var(--rotation));
        opacity: 0;
      }
    }
    #hero-animation .particle {
      animation: op-hero-particleFly var(--duration) ease-out forwards;
      animation-delay: var(--delay);
    }
    @keyframes op-hero-fieldAppear {
      0%   { opacity: 0; transform: translateX(-12px); }
      100% { opacity: 1; transform: translateX(0); }
    }
    #hero-animation .field-filling {
      animation: op-hero-fieldAppear 0.3s ease-out forwards;
    }
    @keyframes op-hero-popIn {
      0%   { opacity: 0; transform: scale(0.85); }
      70%  { transform: scale(1.05); }
      100% { opacity: 1; transform: scale(1); }
    }
    #hero-animation .validated-pop {
      animation: op-hero-popIn 0.4s ease-out forwards;
    }
  </style>

  <div class="bg-white/50 rounded-2xl p-8 md:p-12 border border-gray-100 shadow-sm relative overflow-hidden h-[450px] flex items-center justify-between">
    <!-- Left Half: Document Source & Sliding Path -->
    <div class="relative flex h-full w-1/2 items-center justify-start overflow-hidden pl-12">
      <div class="relative h-80 w-64" id="doc-stack">
        <!-- Documents rendered by script -->
      </div>
    </div>

    <!-- Center: Processing Engine -->
    <div
      id="hero-center-line"
      class="absolute bottom-0 left-1/2 top-0 z-10 w-[2px] -translate-x-1/2 bg-[#FF4500] line-pulse"
      aria-hidden="true"
    ></div>
    <div
      class="absolute left-1/2 top-1/2 z-20 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[#FF4500] bg-white p-3 shadow-lg"
    >
      <img
        src="/OrderPilot%20Logo%20Assets%20(3).svg"
        alt=""
        class="h-full w-full object-contain"
        loading="eager"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </div>

    <!-- Shred Particles: same geometry as pre-Astro — left-1/2 without -translate-x-1/2 so box
         starts on the center line; particles at left:0 sit on the line and fly with +endX to the right -->
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 z-10 h-80 w-64 -translate-y-1/2"
      id="particle-container"
    ></div>

    <!-- Right Half: Captured Information -->
    <div class="w-1/2 flex justify-end items-center pr-12">
      <div class="w-64 flex-shrink-0 bg-white rounded-xl shadow-md border border-gray-200 p-5 z-20">
        <div class="flex justify-between items-center mb-4">
          <div class="flex items-center gap-1.5">
            <div class="w-2 h-2 rounded-full bg-[#FF4500]"></div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-gray-700">Captured Information</span>
          </div>
          <span class="text-[10px] font-semibold text-[#FF4500]">99.9% ACCURACY</span>
        </div>

        <div class="flex justify-between items-center mb-1">
          <span class="text-[9px] uppercase tracking-wider text-gray-400 font-medium">Field</span>
          <span class="text-[9px] uppercase tracking-wider text-gray-400 font-medium">Extracted Data</span>
        </div>
        <div class="border-b border-gray-100 mb-2"></div>

        <div class="space-y-1" id="data-rows">
          <div class="flex justify-between items-center py-2 border-b border-gray-50" data-field="vendor">
            <span class="text-xs font-medium text-gray-600">Vendor Name</span>
            <div class="text-right" data-value></div>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-50" data-field="po">
            <span class="text-xs font-medium text-gray-600">PO Number</span>
            <div class="text-right" data-value></div>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-50" data-field="total">
            <span class="text-xs font-medium text-gray-600">Total Amount</span>
            <div class="text-right" data-value></div>
          </div>
          <div class="flex justify-between items-center py-2" data-field="items">
            <span class="text-xs font-medium text-gray-600">Line Items</span>
            <div class="text-right" data-value></div>
          </div>
        </div>

        <div class="border-b border-gray-100 my-3"></div>

        <div class="h-6 flex items-center justify-center" id="validated-container">
          <!-- Validated badge injected by script -->
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const PO_DATA = [
    {
      type: 'email',
      vendor: "Breman Installatiegroep",
      poNumber: "PO-2024-0847",
      total: "\u20AC12,450.00",
      items: "3 items",
      header: "INCOMING EMAIL",
      color: "#FF4500",
      colorClass: "text-[#FF4500]",
      bgClass: "bg-orange-50",
      headerColorClass: "text-[#FF4500]",
    },
    {
      type: 'pdf',
      vendor: "Nedcargo Logistics",
      poNumber: "PO-2024-1203",
      total: "\u20AC8,920.00",
      items: "5 items",
      header: "PURCHASE ORDER",
      color: "#3B82F6",
      colorClass: "text-blue-600",
      bgClass: "bg-blue-50",
      headerColorClass: "text-blue-600",
    },
    {
      type: 'spreadsheet',
      vendor: "VDL Industrial Modules",
      poNumber: "PO-2024-0591",
      total: "\u20AC23,100.00",
      items: "7 items",
      header: "SPREADSHEET",
      color: "#10B981",
      colorClass: "text-emerald-600",
      bgClass: "bg-emerald-50",
      headerColorClass: "text-emerald-600",
    },
  ];

  // Inline SVG icons
  const ICONS: Record<string, string> = {
    email: `<svg class="w-3 h-3 text-[#FF4500]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
    pdf: `<svg class="w-3 h-3 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>`,
    spreadsheet: `<svg class="w-3 h-3 text-emerald-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>`,
  };

  function createDocumentCard(poIndex: number): HTMLElement {
    const po = PO_DATA[poIndex];
    const card = document.createElement('div');
    card.className = 'absolute w-64 h-80 bg-white rounded-xl shadow-md border border-gray-200 p-6';
    card.dataset.poIndex = String(poIndex);

    // Build line item rows
    let lineRows = '';
    for (let i = 0; i < 4; i++) {
      lineRows += `
        <div class="grid grid-cols-3 gap-2 px-1 border-b border-gray-50 last:border-0 pb-1">
          <div class="h-2 bg-gray-100 rounded-full w-full"></div>
          <div class="h-2 bg-[#FF4500]/20 rounded-full w-1/2 mx-auto"></div>
          <div class="h-2 bg-gray-100 rounded-full w-full"></div>
        </div>`;
    }

    card.innerHTML = `
      <div class="flex items-center gap-2 mb-4 pb-2 border-b border-gray-100">
        ${ICONS[po.type]}
        <span class="text-[11px] font-bold uppercase tracking-wider ${po.headerColorClass}">${po.header}</span>
      </div>
      <div class="space-y-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="text-[9px] text-gray-400 w-10 uppercase font-bold">From:</span>
          <span class="text-[11px] font-bold text-gray-700 truncate flex-1">${po.vendor}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-[9px] text-gray-400 w-10 uppercase font-bold">PO #:</span>
          <span class="text-[11px] font-bold text-[#FF4500]">${po.poNumber}</span>
        </div>
      </div>
      <div class="mb-4">
        <div class="grid grid-cols-3 gap-1 p-1 rounded mb-2 ${po.bgClass}">
          <span class="text-[9px] uppercase font-bold px-1 ${po.colorClass}">Item</span>
          <span class="text-[9px] uppercase font-bold px-1 text-center ${po.colorClass}">Qty</span>
          <span class="text-[9px] uppercase font-bold px-1 text-right ${po.colorClass}">Price</span>
        </div>
        <div class="space-y-2">${lineRows}</div>
      </div>
      <div class="flex justify-between items-center pt-3 border-t border-gray-100">
        <span class="text-[10px] text-gray-400 uppercase font-bold tracking-tighter">Total Amount</span>
        <span class="text-[12px] font-black text-gray-900">${po.total}</span>
      </div>
    `;
    return card;
  }

  const PROCESSING_HTML = `<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 border-2 border-gray-200 border-t-[#FF4500] rounded-full animate-spin"></div><span class="text-[10px] text-gray-400 italic">processing...</span></div>`;

  function setFieldProcessing(el: Element) {
    const valueEl = el.querySelector('[data-value]');
    if (valueEl) valueEl.innerHTML = PROCESSING_HTML;
  }

  function setFieldValue(el: Element, value: string) {
    const valueEl = el.querySelector('[data-value]');
    if (valueEl) valueEl.innerHTML = `<span class="text-xs font-bold text-gray-900 field-filling inline-block">${value}</span>`;
  }

  // State
  let nextId = 0;
  let documents: { id: number; poIndex: number; phase: string; el: HTMLElement }[] = [];
  let shredInterval: ReturnType<typeof setInterval> | null = null;

  const docStack = document.getElementById('doc-stack')!;
  const particleContainer = document.getElementById('particle-container')!;
  const dataRows = document.querySelectorAll('#data-rows > div');
  const validatedContainer = document.getElementById('validated-container')!;

  function addQueuedDoc(poIndex: number) {
    const el = createDocumentCard(poIndex);
    docStack.appendChild(el);
    documents.push({ id: nextId++, poIndex, phase: 'queued', el });
  }

  function layoutQueue() {
    const queued = documents.filter(d => d.phase === 'queued');
    queued.forEach((doc, i) => {
      const offset = Math.min(i, 2) * 8;
      doc.el.style.top = `${offset}px`;
      doc.el.style.left = `${offset}px`;
      doc.el.style.zIndex = String(5 - i);
      doc.el.style.opacity = String(1 - i * 0.2);
      doc.el.style.transform = `scale(${1 - i * 0.025})`;
    });
  }

  function resetDataPanel() {
    dataRows.forEach(row => setFieldProcessing(row));
    validatedContainer.innerHTML = '';
  }

  function triggerDataFill(poIndex: number) {
    const po = PO_DATA[poIndex];
    resetDataPanel();

    const fields = [
      { el: dataRows[0], value: po.vendor },
      { el: dataRows[1], value: po.poNumber },
      { el: dataRows[2], value: po.total },
      { el: dataRows[3], value: po.items },
    ];

    fields.forEach((f, i) => {
      setTimeout(() => setFieldValue(f.el, f.value), 400 + i * 300);
    });

    setTimeout(() => {
      validatedContainer.innerHTML = `
        <div class="text-xs font-semibold text-[#FF4500] flex items-center gap-1 validated-pop">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          VALIDATED &amp; ERP READY
        </div>`;
    }, 1600);
  }

  function startShredding() {
    if (shredInterval) return;
    shredInterval = setInterval(() => {
      const batch: HTMLElement[] = [];
      for (let j = 0; j < 12; j++) {
        const p = document.createElement('div');
        const size = 5 + Math.random() * 6;
        const endX = 100 + Math.random() * 200;
        const endY = -60 + Math.random() * 120;
        const rotation = Math.random() * 360;
        const duration = 0.5 + Math.random() * 0.5;
        const delay = Math.random() * 0.1;
        const color = Math.random() > 0.4 ? '#FF4500' : Math.random() > 0.5 ? '#FB923C' : '#FFF7ED';

        p.className = 'absolute rounded-[1px] particle';
        p.style.cssText = `width:${size}px;height:${size}px;background-color:${color};left:0;top:${Math.random() * 320}px;--endX:${endX}px;--endY:${endY}px;--rotation:${rotation}deg;--duration:${duration}s;--delay:${delay}s;`;
        particleContainer.appendChild(p);
        batch.push(p);
      }
      setTimeout(() => batch.forEach(p => p.remove()), 800);
    }, 100);
  }

  function stopShredding() {
    if (shredInterval) {
      clearInterval(shredInterval);
      shredInterval = null;
    }
  }

  function advancePipeline() {
    const frontQueued = documents.find(d => d.phase === 'queued');
    if (!frontQueued) return;

    const doc = frontQueued;
    doc.phase = 'sliding';
    doc.el.style.zIndex = '1';
    doc.el.style.opacity = '1';
    doc.el.style.transform = '';
    doc.el.classList.add('document-sliding');

    // Shred when document hits center line (~2s into 3s slide)
    setTimeout(() => startShredding(), 2000);

    // Stop shredding + trigger data fill when through (~3s)
    setTimeout(() => {
      stopShredding();
      triggerDataFill(doc.poIndex);
    }, 3000);

    // Remove document element
    setTimeout(() => {
      doc.el.remove();
      documents = documents.filter(d => d.id !== doc.id);
    }, 3500);

    // Re-layout remaining queued cards
    layoutQueue();

    // Replenish queue
    while (documents.length < 12) {
      const last = documents[documents.length - 1];
      const lastIdx = last ? last.poIndex : -1;
      addQueuedDoc((lastIdx + 1) % PO_DATA.length);
    }
    layoutQueue();
  }

  // Initialize
  resetDataPanel();
  for (let i = 0; i < 12; i++) {
    addQueuedDoc(i % PO_DATA.length);
  }
  layoutQueue();

  // Run pipeline
  advancePipeline();
  setInterval(advancePipeline, 4000);
</script>
