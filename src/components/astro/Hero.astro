---
import HeroAnimation from '../react/HeroAnimation.tsx';
---

<section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 fade-in">
  <div class="max-w-4xl mx-auto text-center">
    <div class="inline-flex items-center bg-rb2-orange/10 text-rb2-orange text-xs font-semibold px-4 py-1.5 rounded-full mb-8">
      NOW IN PUBLIC BETA
    </div>

    <h1 class="text-5xl md:text-6xl lg:text-7xl font-[800] tracking-tight text-text-primary mb-8 leading-[1.1]">
      Stop Manually Entering Purchase Orders.<br />
      Start Getting Them <span class="font-serif italic text-rb2-orange">Right.</span>
    </h1>

    <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed">
      OrderPilot turns purchase order emails into validated, ERP-ready data in under 60 seconds.
      Your team spends 15 hours a week on data entry. It should be zero.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#contact"
        data-hero-cta="primary"
        class="w-full sm:w-auto bg-rb2-orange text-white rounded-2xl font-semibold px-8 py-4 hover:bg-rb2-orange-hover hover:shadow-lg transition-all duration-200"
      >
        Get in Touch
      </a>
      <a
        href="/calculator"
        data-hero-cta="secondary"
        class="w-full sm:w-auto bg-white text-text-primary border border-gray-200 rounded-2xl font-semibold px-8 py-4 shadow-sm hover:bg-gray-50 hover:shadow-md transition-all duration-200 flex items-center justify-center gap-2"
      >
        Calculate your costs
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Trust Strip -->
    <div class="mb-16">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-text-muted mb-6">
        Works with: Business Central &middot; Exact Online &middot; Odoo &middot; NetSuite &middot; SAP
      </p>
    </div>
  </div>

  <!-- Processing Animation -->
  <div class="max-w-[1200px] mx-auto mt-8">
    <HeroAnimation client:load />
  </div>
</section>

<script>
  import posthog from 'posthog-js';

  // CTA click tracking
  document.querySelectorAll('[data-hero-cta]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const anchor = btn as HTMLAnchorElement;
      const type = anchor.getAttribute('data-hero-cta');
      const text = anchor.textContent?.trim() || '';

      posthog.capture('hero_cta_clicked', {
        cta_type: type === 'primary' ? 'expert_contact' : 'calculator',
        cta_text: text,
        location: type === 'primary' ? 'hero_primary' : 'hero_secondary'
      });
    });
  });
</script>
