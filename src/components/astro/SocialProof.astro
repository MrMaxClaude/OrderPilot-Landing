---
const testimonials = [
  {
    pill: "WhatsApp to ERP",
    quote: "We get orders via WhatsApp, fax and email, all processed manually. Orderpilot finally turns that chaos into one automated flow. From napkin to order, literally.",
    author: "Operations Manager",
    company: "B2B Technical Wholesaler, The Netherlands",
    featured: true
  },
  {
    pill: "Four systems unified",
    quote: "Our quote-to-order process ran across four different systems. Errors and delays always came from transferring data between them. That problem is now solved.",
    author: "Sales Manager",
    company: "Industrial Food Manufacturer (5,000+ employees), USA"
  },
  {
    pill: "30 min to 3 min",
    quote: "What used to take 30 minutes of manual entry per order now takes under 3. We finally spend our time on customers instead of copying data between screens.",
    author: "Customer Service Lead",
    company: "Building Materials Distributor, Germany"
  },
  {
    pill: "Future-proof value",
    quote: "What Orderpilot built works. It's measurable, future-proof, and designed to add real business value from day one.",
    author: "Sander van Duijn, Digital Transformation Expert",
    company: "INSPIRED Pet Nutrition"
  }
];
---

<section
  id="results"
  class="py-20 lg:py-32 fade-in border-t border-gray-100"
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-16">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-text-muted mb-4 block">/ RESULTS</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-text-primary mb-12">
        What procurement teams <span class="font-serif italic text-rb2-orange">see</span><br />
        after switching.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { val: '80%', label: 'less time on PO processing' },
          { val: '95%', label: 'fewer data entry errors' },
          { val: '6 weeks', label: 'to full ROI' },
        ].map((m) => (
          <div class="flex flex-col">
            <div class="text-5xl font-extrabold text-rb2-orange mb-2">{m.val}</div>
            <div class="text-sm text-text-muted font-bold uppercase tracking-widest">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Testimonials Carousel -->
    <div class="relative mb-24" data-carousel>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-track>
        {testimonials.map((t, i) => (
          <div
            data-card={i}
            class:list={[
              'rounded-3xl p-8 border flex flex-col justify-between relative overflow-hidden transition-all duration-500 ease-in-out',
              i === 1
                ? 'bg-gradient-to-br from-rb2-orange to-amber-accent text-white border-rb2-orange shadow-xl scale-105 z-10'
                : 'bg-card-white border-gray-100 shadow-sm scale-95 opacity-75'
            ]}
          >
            <div class="relative z-10">
              <div class:list={[
                'inline-flex items-center text-[10px] font-bold px-3 py-1 rounded-full mb-6 uppercase tracking-wider',
                i === 1
                  ? 'bg-white/20 text-white border border-white/30'
                  : 'bg-rb2-orange/10 text-rb2-orange'
              ]}>
                {t.pill}
              </div>
              <p class:list={[
                'text-base font-serif italic mb-8 leading-relaxed',
                i === 1 ? 'text-white' : 'text-text-primary'
              ]}>
                &ldquo;{t.quote}&rdquo;
              </p>
              <div>
                <div class:list={[
                  'font-bold text-sm',
                  i === 1 ? 'text-white' : 'text-text-primary'
                ]}>{t.author}</div>
                <div class:list={[
                  'text-[10px] uppercase tracking-widest',
                  i === 1 ? 'text-white/80' : 'text-text-muted'
                ]}>{t.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <div class="flex justify-center items-center mt-8 space-x-6">
        <button
          data-prev
          class="w-10 h-10 rounded-full bg-gray-100 hover:bg-rb2-orange hover:text-white transition-all duration-300 flex items-center justify-center text-gray-600 hover:scale-110"
          aria-label="Previous testimonials"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="flex space-x-2" data-dots>
          {testimonials.map((_, i) => (
            <button
              data-dot={i}
              class:list={[
                'w-2 h-2 rounded-full transition-all duration-300',
                i === 0 ? 'bg-rb2-orange scale-125' : 'bg-gray-300 hover:bg-gray-400'
              ]}
              aria-label={`Show testimonials starting from ${i + 1}`}
            />
          ))}
        </div>

        <button
          data-next
          class="w-10 h-10 rounded-full bg-gray-100 hover:bg-rb2-orange hover:text-white transition-all duration-300 flex items-center justify-center text-gray-600 hover:scale-110"
          aria-label="Next testimonials"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Logo Bar -->
  <div class="max-w-[1200px] mx-auto px-6 lg:px-10 text-center">
    <p class="text-xs font-bold text-text-muted uppercase tracking-[0.2em] mb-8">
      Trusted by procurement teams across manufacturing, distribution, and wholesale.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-12 opacity-30 font-black text-xl text-text-primary">
      <span class="text-rb2-orange opacity-100">IPN PET FOOD</span>
      <span>VDL GROUP</span>
      <span>NEDCARGO</span>
      <span>BREMAN</span>
      <span>GLOBALTRADE</span>
      <span>LOGISYS</span>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector('[data-carousel]') as HTMLElement;
  if (carousel) {
    const cards = carousel.querySelectorAll('[data-card]') as NodeListOf<HTMLElement>;
    const dots = carousel.querySelectorAll('[data-dot]') as NodeListOf<HTMLButtonElement>;
    const prevBtn = carousel.querySelector('[data-prev]') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('[data-next]') as HTMLButtonElement;
    const total = cards.length;
    let current = 0;

    const centerStyles = 'bg-gradient-to-br from-rb2-orange to-amber-accent text-white border-rb2-orange shadow-xl scale-105 z-10';
    const sideStyles = 'bg-card-white border-gray-100 shadow-sm scale-95 opacity-75';
    const centerPill = 'bg-white/20 text-white border border-white/30';
    const sidePill = 'bg-rb2-orange/10 text-rb2-orange';
    function getVisible(startIndex: number) {
      const indices = [];
      for (let i = 0; i < 3; i++) {
        indices.push((startIndex + i) % total);
      }
      return indices;
    }

    function applyStyles(el: HTMLElement, isCenter: boolean) {
      // Card styles
      const remove = isCenter ? sideStyles : centerStyles;
      const add = isCenter ? centerStyles : sideStyles;
      remove.split(' ').forEach(c => el.classList.remove(c));
      add.split(' ').forEach(c => el.classList.add(c));

      // Pill
      const pill = el.querySelector('.inline-flex') as HTMLElement;
      if (pill) {
        const removePill = isCenter ? sidePill : centerPill;
        const addPill = isCenter ? centerPill : sidePill;
        removePill.split(' ').forEach(c => pill.classList.remove(c));
        addPill.split(' ').forEach(c => pill.classList.add(c));
      }

      // Quote text
      const quote = el.querySelector('.font-serif') as HTMLElement;
      if (quote) {
        quote.classList.toggle('text-white', isCenter);
        quote.classList.toggle('text-text-primary', !isCenter);
      }

      // Author
      const author = el.querySelector('.font-bold.text-sm') as HTMLElement;
      if (author) {
        author.classList.toggle('text-white', isCenter);
        author.classList.toggle('text-text-primary', !isCenter);
      }

      // Company
      const company = el.querySelector('.tracking-widest') as HTMLElement;
      if (company) {
        company.classList.toggle('text-white\\/80', isCenter);
        company.classList.toggle('text-text-muted', !isCenter);
      }
    }

    function update() {
      const visible = getVisible(current);

      // Hide all cards, show visible ones
      cards.forEach((card, i) => {
        if (visible.includes(i)) {
          card.style.display = '';
          const centerIndex = visible[1];
          applyStyles(card, i === centerIndex);
        } else {
          card.style.display = 'none';
        }
      });

      // Update dots
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-rb2-orange', i === current);
        dot.classList.toggle('scale-125', i === current);
        dot.classList.toggle('bg-gray-300', i !== current);
      });
    }

    prevBtn.addEventListener('click', () => {
      current = current === 0 ? total - 1 : current - 1;
      update();
    });

    nextBtn.addEventListener('click', () => {
      current = (current + 1) % total;
      update();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        current = parseInt(dot.getAttribute('data-dot') || '0');
        update();
      });
    });

    // Initial render
    update();
  }
</script>
