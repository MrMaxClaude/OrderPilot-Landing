---
import Logo from './Logo.astro';
---

<div class="min-h-screen bg-[#F5F3EF]">
  <!-- Top bar -->
  <div class="max-w-4xl mx-auto px-6 py-6 flex items-center justify-between">
    <a href="/" class="hover:opacity-80 transition-opacity">
      <Logo size={40} />
    </a>
    <a href="/" class="text-sm text-gray-400 hover:text-gray-600 transition-colors flex items-center gap-1">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Back to homepage
    </a>
  </div>

  <!-- Dark card container -->
  <div class="flex items-center justify-center px-6 pb-12 pt-4">
    <div class="w-full max-w-4xl bg-gray-900 rounded-[2.5rem] p-8 md:p-14 lg:p-16 relative overflow-hidden shadow-2xl min-h-[650px] flex flex-col">
      <!-- Dot grid pattern overlay -->
      <div
        class="absolute inset-0 opacity-[0.03] pointer-events-none"
        style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 24px 24px;"
      ></div>

      <!-- PHASE: INTRO -->
      <div data-phase="intro" class="relative z-10 animate-fadeIn">
        <!-- Right side decorative element -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 hidden lg:block opacity-[0.06] pointer-events-none">
          <div class="flex items-end gap-3 h-64">
            <div class="w-12 bg-white rounded-t-lg" style="height: 40%"></div>
            <div class="w-12 bg-white rounded-t-lg" style="height: 70%"></div>
            <div class="w-12 bg-white rounded-t-lg" style="height: 55%"></div>
            <div class="w-12 bg-rb2-orange rounded-t-lg" style="height: 100%"></div>
          </div>
        </div>

        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-8">
          <div class="w-8 h-px bg-rb2-orange"></div>
          <span class="text-xs font-bold tracking-[0.2em] text-rb2-orange uppercase">
            Free Assessment
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-[800] text-white tracking-tight leading-[1.1] max-w-xl">
          What does manual PO processing{' '}
          <span class="font-serif italic text-rb2-orange">actually cost you?</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-gray-400 mt-6 max-w-lg leading-relaxed">
          7 questions. 2 minutes. Find out exactly where your procurement budget leaks — and how much.
        </p>

        <!-- Category pills -->
        <div class="flex flex-wrap gap-3 mt-12">
          <div class="flex flex-col items-center gap-2.5 bg-gray-800/80 border border-gray-700/50 rounded-2xl px-7 py-5 min-w-[100px]">
            <!-- Users icon -->
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="text-[10px] font-bold tracking-[0.15em] text-gray-400 uppercase">LABOR</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 bg-gray-800/80 border border-gray-700/50 rounded-2xl px-7 py-5 min-w-[100px]">
            <!-- AlertTriangle icon -->
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            <span class="text-[10px] font-bold tracking-[0.15em] text-gray-400 uppercase">ERRORS</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 bg-gray-800/80 border border-gray-700/50 rounded-2xl px-7 py-5 min-w-[100px]">
            <!-- Clock icon -->
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="text-[10px] font-bold tracking-[0.15em] text-gray-400 uppercase">DELAYS</span>
          </div>
          <div class="flex flex-col items-center gap-2.5 bg-gray-800/80 border border-gray-700/50 rounded-2xl px-7 py-5 min-w-[100px]">
            <!-- RefreshCw icon -->
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            <span class="text-[10px] font-bold tracking-[0.15em] text-gray-400 uppercase">REWORK</span>
          </div>
        </div>

        <!-- Meta badges -->
        <div class="flex flex-wrap gap-6 mt-12">
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-rb2-orange"></div>
            <span class="text-sm text-gray-400 font-medium">7 questions</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-rb2-orange"></div>
            <span class="text-sm text-gray-400 font-medium">2 minutes</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-rb2-orange"></div>
            <span class="text-sm text-gray-400 font-medium">Instant results</span>
          </div>
        </div>

        <!-- CTA button -->
        <button
          id="start-btn"
          class="mt-10 inline-flex items-center px-8 py-4 bg-rb2-orange text-white rounded-2xl font-bold text-lg hover:bg-rb2-orange-hover hover:shadow-2xl hover:shadow-orange-500/20 transition-all hover:-translate-y-0.5"
        >
          Start the calculator
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>

      <!-- PHASE: QUESTIONS -->
      <div data-phase="questions" hidden class="relative z-10 flex flex-col h-full animate-fadeIn">
        <!-- Category Navigation -->
        <div class="flex items-center gap-2 mb-6" id="category-nav">
          <div data-cat="LABOR" class="px-4 py-2 rounded-full text-[10px] font-bold tracking-[0.15em] uppercase transition-all bg-rb2-orange text-white">LABOR</div>
          <div data-cat="ERRORS" class="px-4 py-2 rounded-full text-[10px] font-bold tracking-[0.15em] uppercase transition-all bg-transparent border border-gray-700 text-gray-500">ERRORS</div>
          <div data-cat="DELAYS" class="px-4 py-2 rounded-full text-[10px] font-bold tracking-[0.15em] uppercase transition-all bg-transparent border border-gray-700 text-gray-500">DELAYS</div>
          <div data-cat="CONTEXT" class="px-4 py-2 rounded-full text-[10px] font-bold tracking-[0.15em] uppercase transition-all bg-transparent border border-gray-700 text-gray-500">CONTEXT</div>

          <!-- Question counter -->
          <div class="ml-auto text-sm text-gray-500 font-mono">
            <span id="step-current" class="text-white font-bold">01</span>
            <span class="text-gray-600">/07</span>
          </div>
        </div>

        <!-- Progress line -->
        <div class="w-full h-0.5 bg-gray-800 rounded-full mb-10">
          <div id="progress-bar" class="h-full bg-rb2-orange rounded-full transition-all duration-500" style="width: 14.29%"></div>
        </div>

        <!-- Question 0: volume -->
        <div data-question="0" class="animate-slideInRight">
          <p class="text-sm text-gray-500 mb-4 uppercase tracking-widest font-bold">
            <span data-category-label>LABOR</span> — Question <span data-step-label>1</span> of 7
          </p>
          <h2 class="text-2xl md:text-3xl font-[800] text-white tracking-tight leading-snug max-w-xl">
            How many purchase orders does your team process per month?
          </h2>
          <div class="mt-10 space-y-3 max-w-2xl">
            <button data-option data-key="volume" data-value="25" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">A</div>
              <span class="text-sm font-medium transition-all text-gray-300">Under 50</span>
            </button>
            <button data-option data-key="volume" data-value="100" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">B</div>
              <span class="text-sm font-medium transition-all text-gray-300">50–150</span>
            </button>
            <button data-option data-key="volume" data-value="225" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">C</div>
              <span class="text-sm font-medium transition-all text-gray-300">150–300</span>
            </button>
            <button data-option data-key="volume" data-value="400" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">D</div>
              <span class="text-sm font-medium transition-all text-gray-300">300+</span>
            </button>
          </div>
          <!-- Feedback -->
          <div data-feedback class="mt-6 bg-gray-800/80 rounded-xl p-4 border border-gray-700/30 animate-fadeIn max-w-2xl" hidden>
            <div class="flex gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange flex-shrink-0 mt-0.5"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
              <p data-feedback-text class="text-sm text-gray-400 leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- Question 1: time -->
        <div data-question="1" hidden class="animate-slideInRight">
          <p class="text-sm text-gray-500 mb-4 uppercase tracking-widest font-bold">
            <span data-category-label>LABOR</span> — Question <span data-step-label>2</span> of 7
          </p>
          <h2 class="text-2xl md:text-3xl font-[800] text-white tracking-tight leading-snug max-w-xl">
            How long does it take to process one PO — from email to ERP entry?
          </h2>
          <div class="mt-10 space-y-3 max-w-2xl">
            <button data-option data-key="time" data-value="0.125" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">A</div>
              <span class="text-sm font-medium transition-all text-gray-300">Under 10 minutes</span>
            </button>
            <button data-option data-key="time" data-value="0.25" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">B</div>
              <span class="text-sm font-medium transition-all text-gray-300">10–20 minutes</span>
            </button>
            <button data-option data-key="time" data-value="0.42" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">C</div>
              <span class="text-sm font-medium transition-all text-gray-300">20–30 minutes</span>
            </button>
            <button data-option data-key="time" data-value="0.58" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">D</div>
              <span class="text-sm font-medium transition-all text-gray-300">30+ minutes</span>
            </button>
          </div>
          <div data-feedback class="mt-6 bg-gray-800/80 rounded-xl p-4 border border-gray-700/30 animate-fadeIn max-w-2xl" hidden>
            <div class="flex gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange flex-shrink-0 mt-0.5"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
              <p data-feedback-text class="text-sm text-gray-400 leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- Question 2: team -->
        <div data-question="2" hidden class="animate-slideInRight">
          <p class="text-sm text-gray-500 mb-4 uppercase tracking-widest font-bold">
            <span data-category-label>LABOR</span> — Question <span data-step-label>3</span> of 7
          </p>
          <h2 class="text-2xl md:text-3xl font-[800] text-white tracking-tight leading-snug max-w-xl">
            How many people spend time processing POs?
          </h2>
          <div class="mt-10 space-y-3 max-w-2xl">
            <button data-option data-key="team" data-value="1" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">A</div>
              <span class="text-sm font-medium transition-all text-gray-300">1 person</span>
            </button>
            <button data-option data-key="team" data-value="2.5" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">B</div>
              <span class="text-sm font-medium transition-all text-gray-300">2–3 people</span>
            </button>
            <button data-option data-key="team" data-value="4.5" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">C</div>
              <span class="text-sm font-medium transition-all text-gray-300">4–5 people</span>
            </button>
            <button data-option data-key="team" data-value="7" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">D</div>
              <span class="text-sm font-medium transition-all text-gray-300">6+ people</span>
            </button>
          </div>
          <div data-feedback class="mt-6 bg-gray-800/80 rounded-xl p-4 border border-gray-700/30 animate-fadeIn max-w-2xl" hidden>
            <div class="flex gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange flex-shrink-0 mt-0.5"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
              <p data-feedback-text class="text-sm text-gray-400 leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- Question 3: errors -->
        <div data-question="3" hidden class="animate-slideInRight">
          <p class="text-sm text-gray-500 mb-4 uppercase tracking-widest font-bold">
            <span data-category-label>ERRORS</span> — Question <span data-step-label>4</span> of 7
          </p>
          <h2 class="text-2xl md:text-3xl font-[800] text-white tracking-tight leading-snug max-w-xl">
            How often do PO processing errors occur — wrong quantities, incorrect prices, mismatched vendor codes?
          </h2>
          <div class="mt-10 space-y-3 max-w-2xl">
            <button data-option data-key="errors" data-value="0.03" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">A</div>
              <span class="text-sm font-medium transition-all text-gray-300">Rarely (under 5%)</span>
            </button>
            <button data-option data-key="errors" data-value="0.075" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">B</div>
              <span class="text-sm font-medium transition-all text-gray-300">Sometimes (5–10%)</span>
            </button>
            <button data-option data-key="errors" data-value="0.15" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">C</div>
              <span class="text-sm font-medium transition-all text-gray-300">Often (10–20%)</span>
            </button>
            <button data-option data-key="errors" data-value="0.25" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">D</div>
              <span class="text-sm font-medium transition-all text-gray-300">Very often (20%+)</span>
            </button>
          </div>
          <div data-feedback class="mt-6 bg-gray-800/80 rounded-xl p-4 border border-gray-700/30 animate-fadeIn max-w-2xl" hidden>
            <div class="flex gap-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-rb2-orange flex-shrink-0 mt-0.5"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
              <p data-feedback-text class="text-sm text-gray-400 leading-relaxed"></p>
            </div>
          </div>
        </div>

        <!-- Question 4: delay -->
        <div data-question="4" hidden class="animate-slideInRight">
          <p class="text-sm text-gray-500 mb-4 uppercase tracking-widest font-bold">
            <span data-category-label>DELAYS</span> — Question <span data-step-label>5</span> of 7
          </p>
          <h2 class="text-2xl md:text-3xl font-[800] text-white tracking-tight leading-snug max-w-xl">
            What's the typical delay between receiving a PO email and entering it into your ERP?
          </h2>
          <div class="mt-10 space-y-3 max-w-2xl">
            <button data-option data-key="delay" data-value="0" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">A</div>
              <span class="text-sm font-medium transition-all text-gray-300">Same day</span>
            </button>
            <button data-option data-key="delay" data-value="1.5" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">B</div>
              <span class="text-sm font-medium transition-all text-gray-300">1–2 days</span>
            </button>
            <button data-option data-key="delay" data-value="4" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400">C</div>
              <span class="text-sm font-medium transition-all text-gray-300">3–5 days</span>
            </button>
            <button data-option data-key="delay" data-value="7" class="w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600">
