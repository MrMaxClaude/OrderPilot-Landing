<script>
  import posthog from 'posthog-js';

  // --- CONSTANTS ---
  const HOURLY_STAFF_COST = 42;
  const MANAGER_HOURLY_COST = 62;
  const ERROR_RESOLUTION_TIME = 0.33;
  const AVG_INVOICE_VALUE = 2500;
  const EARLY_PAYMENT_DISCOUNT = 0.02;
  const REWORK_RATE = 0.25;
  const ESCALATION_RATE = 0.10;

  const ERP_NAMES: Record<string, string> = {
    'business-central': 'Business Central',
    exact: 'Exact Online',
    odoo: 'Odoo',
    netsuite: 'NetSuite',
    sap: 'SAP',
    other: 'ERP'
  };

  const CATEGORIES = [
    { label: 'LABOR', questions: [0, 1, 2] },
    { label: 'ERRORS', questions: [3] },
    { label: 'DELAYS', questions: [4] },
    { label: 'CONTEXT', questions: [5, 6] }
  ];

  const QUESTION_KEYS = ['volume', 'time', 'team', 'errors', 'delay', 'erp', 'size'];

  // --- STATE ---
  let phase = 'intro';
  let currentStep = 0;
  let answers: Record<string, number | string> = {};
  let results: ReturnType<typeof calculateCosts> | null = null;
  let isSubmitting = false;

  // --- DOM REFS ---
  const startBtn = document.getElementById('start-btn')!;
  const backBtn = document.getElementById('back-btn')!;
  const continueBtn = document.getElementById('continue-btn')!;
  const openModalBtn = document.getElementById('open-modal-btn')!;
  const closeModalBtn = document.getElementById('close-modal-btn')!;
  const modalBackdrop = document.getElementById('modal-backdrop')!;
  const emailModal = document.getElementById('email-modal')!;
  const reportForm = document.getElementById('report-form') as HTMLFormElement;
  const inputFirstName = document.getElementById('input-firstname') as HTMLInputElement;
  const inputEmail = document.getElementById('input-email') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn')!;
  const submitArrow = document.getElementById('submit-arrow')!;
  const progressBar = document.getElementById('progress-bar')!;
  const stepCurrent = document.getElementById('step-current')!;
  const categoryNav = document.getElementById('category-nav')!;
  const barChart = document.getElementById('bar-chart')!;

  // --- COST CALCULATION ---
  function calculateCosts(ans: Record<string, number | string>) {
    const volume = (ans.volume as number) || 100;
    const time = (ans.time as number) || 0.25;
    const errors = (ans.errors as number) || 0.075;
    const delay = (ans.delay as number) || 0;

    const laborCost = volume * time * HOURLY_STAFF_COST * 12;

    const monthlyErrors = volume * errors;
    const errorCost = monthlyErrors * ERROR_RESOLUTION_TIME * HOURLY_STAFF_COST * 12;

    let delayCost = 0;
    if (delay > 0) {
      let delayFactor = 0;
      if (delay <= 1.5) delayFactor = 0.30;
      else if (delay <= 4) delayFactor = 0.60;
      else delayFactor = 0.85;
      const delayedPOs = volume * delayFactor;
      delayCost = delayedPOs * AVG_INVOICE_VALUE * EARLY_PAYMENT_DISCOUNT * 12;
    }

    const monthlyRework = monthlyErrors * REWORK_RATE;
    const reworkCost = monthlyRework * ERROR_RESOLUTION_TIME * HOURLY_STAFF_COST * 12;
    const monthlyEscalations = volume * ESCALATION_RATE;
    const escalationCost = monthlyEscalations * 0.5 * MANAGER_HOURLY_COST * 12;
    const reworkEscalationCost = reworkCost + escalationCost;

    const totalCost = laborCost + errorCost + delayCost + reworkEscalationCost;
    const costPerPO = totalCost / (volume * 12);
    const weeklyHours = (volume * time * 12 / 52);
    const annualHours = weeklyHours * 52;
    const potentialSavings = totalCost - 6000;

    return {
      laborCost: Math.round(laborCost),
      errorCost: Math.round(errorCost),
      delayCost: Math.round(delayCost),
      reworkEscalationCost: Math.round(reworkEscalationCost),
      totalCost: Math.round(totalCost),
      costPerPO: Math.round(costPerPO),
      weeklyHours: weeklyHours.toFixed(1),
      annualHours: Math.round(annualHours),
      potentialSavings: Math.round(potentialSavings),
      roi: (totalCost / 6000).toFixed(1),
    };
  }

  function getLargestCategory(costs: { laborCost: number; errorCost: number; delayCost: number; reworkEscalationCost: number }) {
    const categories = [
      { name: 'Processing delays', value: costs.delayCost },
      { name: 'Direct labor', value: costs.laborCost },
      { name: 'Rework & escalation', value: costs.reworkEscalationCost },
      { name: 'Error correction', value: costs.errorCost }
    ];
    return categories.sort((a, b) => b.value - a.value)[0].name;
  }

  // --- FEEDBACK FUNCTIONS ---
  function getFeedback(step: number, val: number | string, ans: Record<string, number | string>): string {
    const v = val as number;
    const volume = (ans.volume as number) || 100;

    switch (step) {
      case 0: {
        const yearly = v * 12;
        return `That's roughly ${yearly.toLocaleString()} orders per year.${v >= 100 ? ' Every minute per order adds up fast.' : ''}`;
      }
      case 1: {
        const weeklyHours = (volume * v * 12 / 52).toFixed(1);
        if (v <= 0.125) return `That's about ${weeklyHours} hours per week on data entry.`;
        if (v <= 0.25) return `That's ${weeklyHours} hours per week. Almost a full workday, every week, just on PO entry.`;
        if (v <= 0.42) return `That's ${weeklyHours} hours per week. That's a part-time employee doing nothing but copy-pasting.`;
        return `That's ${weeklyHours} hours per week — more than a full workday, every single week.`;
      }
      case 2: {
        if (v === 1) return "One person handling all PO processing. That's a single point of failure.";
        if (v <= 2.5) return 'Multiple people spending their day on manual data entry instead of procurement work.';
        if (v <= 4.5) return "That's significant headcount dedicated to a process that should be automated.";
        return 'Six or more people. The coordination overhead alone costs thousands per year.';
      }
      case 3: {
        const monthlyErrors = Math.round(volume * v);
        if (v <= 0.03) return `Even at 3%, that's ${monthlyErrors} errors per month that each cost \u20AC35\u2013\u20AC120 to fix.`;
        if (v <= 0.075) return `At your volume, that's roughly ${monthlyErrors} errors per month. Each one takes 15\u201330 minutes to find and fix.`;
        if (v <= 0.15) return `That's ${monthlyErrors} errors per month. At \u20AC75 average cost per error, the math isn't pretty.`;
        return `${monthlyErrors} errors per month. This is likely causing supplier relationship damage on top of direct costs.`;
      }
      case 4: {
        if (v === 0) return 'Good. Same-day processing minimizes lost discounts and keeps suppliers happy.';
        if (v <= 1.5) return "A 1-2 day delay means you're likely missing early payment discounts on some orders.";
        if (v <= 4) return `At 3-5 days, you're almost certainly losing 2% early payment discounts. On ${volume} POs/month at \u20AC2,500 average, that's serious money.`;
        return "Over 5 days. That's lost discounts, delayed deliveries, and suppliers who stop prioritizing your orders.";
      }
      case 5: {
        const s = val as string;
        if (s === 'other') return "We may be able to connect to your system via API. We'll include details in your report.";
        const names: Record<string, string> = { 'business-central': 'Business Central', exact: 'Exact Online', odoo: 'Odoo', netsuite: 'NetSuite', sap: 'SAP' };
        return `OrderPilot has a native ${names[s]} connector. Direct integration, no middleware.`;
      }
      case 6: {
        if (v === 25) return "Got it. We'll benchmark you against similar-sized companies.";
        if (v <= 400) return "Mid-market companies your size typically spend \u20AC40,000\u2013\u20AC90,000 annually on PO processing. Let's see your exact number.";
        return "At your scale, processing costs compound fast. Let's calculate the real number.";
      }
      default:
        return '';
    }
  }

  // --- PHASE SWITCHING ---
  function showPhase(name: string) {
    document.querySelectorAll<HTMLElement>('[data-phase]').forEach(el => {
      el.hidden = el.dataset.phase !== name;
    });
    phase = name;
    window.scrollTo(0, 0);
  }

  // --- QUESTION DISPLAY ---
  function showQuestion(step: number) {
    document.querySelectorAll<HTMLElement>('[data-question]').forEach(el => {
      el.hidden = el.dataset.question !== String(step);
    });

    // Update progress bar
    progressBar.style.width = `${((step + 1) / 7) * 100}%`;

    // Update counter
    stepCurrent.textContent = String(step + 1).padStart(2, '0');

    // Update category pills
    const catPills = categoryNav.querySelectorAll<HTMLElement>('[data-cat]');
    const activeCat = CATEGORIES.find(c => c.questions.includes(step))?.label || 'CONTEXT';

    catPills.forEach(pill => {
      const cat = pill.dataset.cat!;
      const catDef = CATEGORIES.find(c => c.label === cat);
      const isActive = cat === activeCat;
      const isComplete = catDef ? catDef.questions.every(q => q < step) : false;

      pill.className = `px-4 py-2 rounded-full text-[10px] font-bold tracking-[0.15em] uppercase transition-all ${
        isActive
          ? 'bg-rb2-orange text-white'
          : isComplete
          ? 'bg-gray-700 text-gray-300'
          : 'bg-transparent border border-gray-700 text-gray-500'
      }`;
    });

    // Update continue button state
    const key = QUESTION_KEYS[step];
    (continueBtn as HTMLButtonElement).disabled = answers[key] === undefined;

    // Update option selection styles for the current question
    updateOptionStyles(step);

    // Show/hide feedback
    const questionEl = document.querySelector<HTMLElement>(`[data-question="${step}"]`)!;
    const feedbackEl = questionEl.querySelector<HTMLElement>('[data-feedback]')!;
    const feedbackText = questionEl.querySelector<HTMLElement>('[data-feedback-text]')!;
    const key2 = QUESTION_KEYS[step];
    if (answers[key2] !== undefined) {
      feedbackEl.hidden = false;
      feedbackText.textContent = getFeedback(step, answers[key2], answers);
    } else {
      feedbackEl.hidden = true;
    }
  }

  function updateOptionStyles(step: number) {
    const key = QUESTION_KEYS[step];
    const questionEl = document.querySelector<HTMLElement>(`[data-question="${step}"]`)!;
    const buttons = questionEl.querySelectorAll<HTMLButtonElement>('[data-option]');

    buttons.forEach(btn => {
      const btnValue = btn.dataset.key === 'erp' ? btn.dataset.value : parseFloat(btn.dataset.value!);
      const isSelected = answers[key] !== undefined && String(answers[key]) === String(btnValue);

      if (isSelected) {
        btn.className = 'w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-rb2-orange/10 border border-rb2-orange/40 shadow-[0_0_20px_rgba(255,69,0,0.1)]';
        const circle = btn.querySelector('div')!;
        circle.className = 'w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-rb2-orange text-white';
        const span = btn.querySelector('span')!;
        span.className = 'text-sm font-medium transition-all text-white';
        // Add glow line if not present
        let glow = btn.querySelector('.glow-line');
        if (!glow) {
          glow = document.createElement('div');
          glow.className = 'glow-line absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-rb2-orange/50 to-transparent';
          btn.appendChild(glow);
        }
      } else {
        btn.className = 'w-full flex items-center gap-4 p-5 rounded-2xl text-left transition-all duration-200 relative overflow-hidden bg-gray-800/60 border border-gray-700/50 hover:bg-gray-800 hover:border-gray-600';
        const circle = btn.querySelector('div')!;
        circle.className = 'w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold transition-all bg-gray-700 text-gray-400';
        const span = btn.querySelector('span')!;
        span.className = 'text-sm font-medium transition-all text-gray-300';
        const glow = btn.querySelector('.glow-line');
        if (glow) glow.remove();
      }
    });
  }

  // --- RESULTS RENDERING ---
  function renderResults() {
    if (!results) return;

    const sortedCats = [
      { name: 'Processing delays', value: results.delayCost },
      { name: 'Direct labor', value: results.laborCost },
      { name: 'Rework & escalation', value: results.reworkEscalationCost },
      { name: 'Error correction', value: results.errorCost }
    ].sort((a, b) => b.value - a.value);

    // Bar chart
    barChart.innerHTML = '';
    sortedCats.forEach((cat, i) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-4';
      const pct = (cat.value / results!.totalCost * 100);
      const opacity = 0.4 + (cat.value / results!.totalCost * 0.6);
      row.innerHTML = `
        <span class="text-[10px] font-bold text-gray-400 w-24 sm:w-32 text-right flex-shrink-0 uppercase tracking-tighter">${cat.name}</span>
        <div class="flex-1 bg-gray-800 rounded-full h-3 overflow-hidden">
          <div class="h-full bg-rb2-orange rounded-full" style="width: ${pct}%; opacity: ${opacity}; animation: barGrow 1s ease-out ${i * 0.2}s forwards; transform: scaleX(0); transform-origin: left;"></div>
        </div>
        <span class="text-sm font-bold text-white w-20 flex-shrink-0">&euro;${cat.value.toLocaleString()}</span>
        <span class="text-xs text-gray-500 w-10 flex-shrink-0">${Math.round(pct)}%</span>
      `;
      barChart.appendChild(row);
    });

    // Cost per PO
    document.getElementById('cost-per-po')!.textContent = `\u20AC${results.costPerPO}`;

    // Weekly hours
    document.getElementById('weekly-hours')!.textContent = `${results.weeklyHours} hours per week`;

    // Savings
    document.getElementById('savings-amount')!.textContent = `\u20AC${Math.round(results.totalCost * 0.85).toLocaleString()}`;
    document.getElementById('savings-hours')!.textContent = `${Math.round(parseFloat(results.weeklyHours) * 0.85)} hours per week`;

    // Modal total
    document.getElementById('modal-total')!.textContent = `\u20AC${results.totalCost.toLocaleString()}/year`;

    // ERP guide text
    const erpName = getErpName();
    document.getElementById('modal-erp-guide')!.textContent = `${erpName}-specific integration guide`;

    // Animated counter
    animateCounter(results.totalCost);
  }

  function animateCounter(target: number) {
    const el = document.getElementById('animated-total')!;
    if (target === 0) {
      el.textContent = '\u20AC0';
      return;
    }
    const start = performance.now();
    const duration = 1500;

    function tick(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3); // ease-out cubic
      const current = Math.round(eased * target);
      el.textContent = `\u20AC${current.toLocaleString()}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  function getErpName(): string {
    return ERP_NAMES[answers.erp as string] || 'ERP';
  }

  // --- EVENT HANDLERS ---

  // Start button
  startBtn.addEventListener('click', () => {
    showPhase('questions');
    showQuestion(0);
    posthog.capture('calculator_started', {
      entry_point: document.referrer.includes('orderpi') ? 'internal' : 'external',
    });
  });

  // Option clicks (delegated)
  document.querySelectorAll<HTMLButtonElement>('[data-option]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.key!;
      const rawValue = btn.dataset.value!;
      const value = (key === 'erp') ? rawValue : parseFloat(rawValue);

      answers[key] = value;

      // Update styles and show feedback
      updateOptionStyles(currentStep);
      const questionEl = document.querySelector<HTMLElement>(`[data-question="${currentStep}"]`)!;
      const feedbackEl = questionEl.querySelector<HTMLElement>('[data-feedback]')!;
      const feedbackText = questionEl.querySelector<HTMLElement>('[data-feedback-text]')!;
      feedbackEl.hidden = false;
      feedbackText.textContent = getFeedback(currentStep, value, answers);

      // Enable continue
      (continueBtn as HTMLButtonElement).disabled = false;

      // Auto-advance after 600ms
      setTimeout(() => {
        if (currentStep < 6) {
          currentStep++;
          showQuestion(currentStep);
        } else {
          // All answered
          results = calculateCosts(answers);
          showPhase('results');
          renderResults();

          posthog.capture('calculator_completed', {
            cost_savings: results.potentialSavings || 0,
            po_volume: answers.volume || 0,
            processing_time: answers.time || 0,
            team_size: answers.team || 0,
          });
        }
      }, 600);
    });
  });

  // Back button
  backBtn.addEventListener('click', () => {
    if (currentStep > 0) {
      currentStep--;
      showQuestion(currentStep);
    } else {
      showPhase('intro');
    }
  });

  // Continue button
  continueBtn.addEventListener('click', () => {
    if (currentStep < 6) {
      currentStep++;
      showQuestion(currentStep);
    } else {
      results = calculateCosts(answers);
      showPhase('results');
      renderResults();
    }
  });

  // Open email modal
  openModalBtn.addEventListener('click', () => {
    emailModal.hidden = false;
  });

  // Close email modal
  closeModalBtn.addEventListener('click', () => {
    emailModal.hidden = true;
  });
  modalBackdrop.addEventListener('click', () => {
    emailModal.hidden = true;
  });

  // Form validation — enable/disable submit
  function validateForm() {
    const fn = inputFirstName.value.trim();
    const em = inputEmail.value.trim();
    (submitBtn as HTMLButtonElement).disabled = isSubmitting || !fn || !em || !em.includes('@');
  }
  inputFirstName.addEventListener('input', validateForm);
  inputEmail.addEventListener('input', validateForm);

  // Form submit
  reportForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isSubmitting || !results) return;

    isSubmitting = true;
    submitBtn.textContent = 'Sending...';
    submitArrow.style.display = 'none';
    (submitBtn as HTMLButtonElement).disabled = true;

    const firstName = inputFirstName.value.trim();
    const email = inputEmail.value.trim();
    const erpName = getErpName();

    const reportData = {
      email,
      firstName,
      companyName: '',
      monthlyVolume: (answers.volume as number) || 225,
      timePerPO: answers.time ? Math.round((answers.time as number) * 60) : 18,
      errorRate: answers.errors || 12,
      erpSystem: erpName
    };

    try {
      const response = await fetch('/api/generate-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(reportData),
        keepalive: true,
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const result = await response.json();

      posthog.capture('calculator_completed', {
        cost_savings: parseFloat(result.data?.annualSavings?.replace(/[^0-9.-]+/g, '') || '0'),
        po_volume: reportData.monthlyVolume * 12,
        processing_time: reportData.timePerPO,
        team_size: answers.team || 1,
      });

      posthog.capture('pdf_report_generated', {
        email: email,
        company_name: reportData.companyName,
        annual_savings: parseFloat(result.data?.annualSavings?.replace(/[^0-9.-]+/g, '') || '0'),
        monthly_po_volume: reportData.monthlyVolume,
        erp_system: erpName,
        lead_score: reportData.monthlyVolume * (reportData.timePerPO / 60) * 42 * 12,
      });

      posthog.identify(email, {
        first_name: firstName,
        email: email,
        company_name: reportData.companyName,
        monthly_po_volume: reportData.monthlyVolume,
      });

      isSubmitting = false;
      emailModal.hidden = true;
      showThankyou(email, erpName);

    } catch (error) {
      console.error('Error generating PDF report:', error);
      isSubmitting = false;

      posthog.capture('calculator_error', {
        error_type: 'pdf_generation_failed',
        error_message: error instanceof Error ? error.message : 'Unknown error',
      });

      // Show success anyway — better UX
      emailModal.hidden = true;
      showThankyou(inputEmail.value.trim(), getErpName());
    }
  });

  function showThankyou(email: string, erpName: string) {
    document.getElementById('thankyou-email')!.textContent = email;
    document.getElementById('thankyou-erp')!.textContent = erpName;
    document.getElementById('thankyou-cost')!.textContent = results ? `\u20AC${results.totalCost.toLocaleString()}` : '';
    showPhase('thankyou');
  }
</script>
